TOOLS = Path(__file__).resolve().parent
REPO = TOOLS.parent

# The front-door script has no .py extension, so name the loader explicitly.
_loader = importlib.machinery.SourceFileLoader("owi_do", str(TOOLS / "owi-do"))
_spec = importlib.util.spec_from_loader("owi_do", _loader)
owi_do = importlib.util.module_from_spec(_spec)
_loader.exec_module(owi_do)

SKILL_TOOLS = {skill: spec["tools"] for skill, spec in owi_do.SKILLS.items()}

DEMO_SNAPSHOT_ID = "snapshot:manager-scenario-v1"
DEMO_SOURCE_REVISION = "scenario:manager-v1"


class WorkspaceProblem(RuntimeError):
    """A setup issue safe to show in the local onboarding screen."""


def setup_payload(home: Path, problem: str | None = None) -> dict:
    """Truthful local-app state for a workspace that is not ready yet."""
    message = problem or (
        "No OWI public index is configured. No models, abilities, prices, "
        "costs, or savings have been loaded."
    )
    return {
        "workers": [],
        "posteriors": {},
        "skillTools": SKILL_TOOLS,
        "fallbackMicros": 20000,
        "floor": 0.24,
        "local": True,
        "configured": False,
        "mode": "unconfigured",
        "runnable": [],
        "ledgerFeedback": {
            "total": 0, "accepted": 0, "modelRejected": 0, "rows": []
        },
        "setup": {
            "message": message,
            "home": str(home),
            "index": str(home / "index.sqlite"),
            "existingCommand": (
                "tools/owi-serve --home PATH_TO_EXISTING_OWI_WORKSPACE"
            ),
            "demoCommand": "tools/owi-serve --demo",
        },
    }


def stored_catalog(home: Path) -> dict:
    """Read the exact workers and prices in the newest stored snapshot.

    This deliberately reads the selected SQLite index rather than rebuilding
    the repository example in memory. The graphical office must describe the
    user's workspace, not a similarly shaped fixture.
    """
    index = home / "index.sqlite"
    if not index.is_file():
        raise WorkspaceProblem(f"No public index exists at {index}.")
    try:
        connection = sqlite3.connect(
            index.resolve().as_uri() + "?mode=ro", uri=True, timeout=5
        )
        connection.row_factory = sqlite3.Row
        try:
            snapshot = connection.execute(
                "SELECT id, source_revision, worker_profile_ids_json "
                "FROM snapshots ORDER BY created_at DESC, id DESC LIMIT 1"
            ).fetchone()
            if snapshot is None:
                raise WorkspaceProblem(
                    "The public index has no immutable snapshot yet."
                )
            member_ids = set(json.loads(snapshot["worker_profile_ids_json"]))
            rows = connection.execute(
                "SELECT w.id, w.supported_skill_ids_json, w.tools_json, "
                "w.privacy_clearance, p.input_micros_per_million_tokens, "
                "p.output_micros_per_million_tokens "
                "FROM worker_profiles AS w "
                "JOIN provider_offerings AS p ON p.id = w.offering_id "
                "ORDER BY w.id"
            ).fetchall()
        finally:
            connection.close()
    except WorkspaceProblem:
        raise
    except (json.JSONDecodeError, sqlite3.Error) as error:
        raise WorkspaceProblem(
            f"The selected public index could not be read: {error}"
        ) from error

    workers = []
    for row in rows:
        if row["id"] not in member_ids:
            continue
        try:
            skills = json.loads(row["supported_skill_ids_json"])
            tools = json.loads(row["tools_json"])
        except json.JSONDecodeError as error:
            raise WorkspaceProblem(
                f"Worker {row['id']} has invalid skills or tools JSON."
            ) from error
        workers.append({
            "id": row["id"],
            "skills": skills,
            "tools": tools,
            "clearance": row["privacy_clearance"],
            "inRate": row["input_micros_per_million_tokens"],
            "outRate": row["output_micros_per_million_tokens"],
        })
    if not workers:
        raise WorkspaceProblem(
            "The newest public snapshot contains no priced worker profiles."
        )
    return {
        "snapshot": snapshot["id"],
        "sourceRevision": snapshot["source_revision"],
        "workers": workers,
    }


def ledger_feedback(home: Path) -> dict:
    """Outcome counts from the private ledger, without exposing task content."""
    local = home / "local.sqlite"
    if local.is_symlink():
        raise WorkspaceProblem("local.sqlite may not be a symlink")
    if not local.is_file():
        return {"total": 0, "accepted": 0, "modelRejected": 0, "rows": []}
    try:
        connection = sqlite3.connect(
            local.resolve().as_uri() + "?mode=ro", uri=True, timeout=5
        )
        try:
            records = connection.execute(
                "SELECT worker_id, skill_id, accepted, metadata_json "
                "FROM outcome_events ORDER BY observed_at, id"
            ).fetchall()
        finally:
            connection.close()
    except sqlite3.Error as error:
        raise WorkspaceProblem(
            f"The private outcome ledger could not be read: {error}"
        ) from error

    grouped: dict[tuple[str, str], dict] = {}
    accepted = model_rejected = 0
    for worker, skill, worked, metadata_json in records:
        try:
            metadata = json.loads(metadata_json or "{}")
        except json.JSONDecodeError:
            metadata = {}
        # Legacy rows without a cause are unknown, not proof against a model.
        model_failure = (
            not bool(worked) and metadata.get("root_cause") == "worker"
        )
        accepted += int(bool(worked))
        model_rejected += int(model_failure)
        row = grouped.setdefault(
            (worker, skill),
            {"worker": worker, "skill": skill, "accepted": 0,
             "modelRejected": 0, "otherRejected": 0},
        )
        if worked:
            row["accepted"] += 1
        elif model_failure:
            row["modelRejected"] += 1
        else:
            row["otherRejected"] += 1
    rows = sorted(
        grouped.values(),
        key=lambda row: (
            -(row["accepted"] + row["modelRejected"] + row["otherRejected"]),
            row["worker"], row["skill"],
        ),
    )
    return {"total": len(records), "accepted": accepted,
            "modelRejected": model_rejected, "rows": rows}


def harvest(home: Path) -> dict:
    """Current posteriors from the engine, including the real ledger."""
    catalog = stored_catalog(home)
    workers = catalog["workers"]

    posteriors: dict = {}
    for position, (skill, tools) in enumerate(SKILL_TOOLS.items(), start=1):
        if not any(skill in worker["skills"] for worker in workers):
            posteriors[skill] = {}
            continue
        request = {
            "decision_id": f"decision:serve-{position}-{int(time.time())}",
            "snapshot_id": catalog["snapshot"],
            "at_epoch_ms": int(time.time() * 1000),
            "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "task": {"id": f"task:serve-harvest-{position}",
                     "summary": f"harvest posteriors for {skill}",
                     "required_skills": [{"skill_id": skill,
                                          "minimum_success_probability": 0.0,
                                          "minimum_evidence_count": 0}],
                     "required_tools": tools,
                     "privacy": "private_metadata", "risk": "low",
                     "verification": "deterministic",
                     "minimum_success_probability": 0.0,
                     "minimum_evidence_count": 0,
                     "estimated_input_tokens": 2000,
                     "estimated_output_tokens": 800},
            "policy": {"policy_id": "policy:economy-v1", "currency": "USD",
                       "quota_shadow_cash_micros_per_unit": 0,
                       "failure_probability_basis": "mean", "max_attempts": 2},
            "calibration": {"calibration_id": "calibration:v1",
                            "confidence_tail_probability": 0.05,
                            "prior_alpha": 1.0, "prior_beta": 1.0,
                            "max_public_prior_weight": 8.0,
                            "private_outcome_weight": 1.0},
            "assumptions": {"default_p95_latency_ms": 30000},
        }
        with tempfile.NamedTemporaryFile(
            mode="w", suffix=".json", prefix="serve-harvest-", dir=home,
            encoding="utf-8", delete=False,
        ) as handle:
            json.dump(request, handle)
            path = Path(handle.name)
        try:
            result = owi_do.owi(
                "allocate", "--index", str(home / "index.sqlite"),
                "--local", str(home / "local.sqlite"),
                "--input", str(path),
            )
        finally:
            path.unlink(missing_ok=True)
        posteriors[skill] = {
            cal["worker_id"]: {"a": cal["skills"][0]["posterior"]["alpha"],
                               "b": cal["skills"][0]["posterior"]["beta"]}
            for cal in result["calibration"] if cal["skills"]}

    runnable_workers = sorted(
        worker["id"] for worker in workers
        if owi_do.resolve_worker_runner(
            home, worker["id"], allow_model_fallback=False
        )[0]
    )
    demo = (catalog["snapshot"] == DEMO_SNAPSHOT_ID
            and catalog["sourceRevision"] == DEMO_SOURCE_REVISION)
    return {"workers": workers, "posteriors": posteriors,
            "skillTools": SKILL_TOOLS, "fallbackMicros": 20000, "floor": 0.24,
            "local": True, "configured": True,
            "mode": "demo" if demo else "configured",
            "snapshot": catalog["snapshot"],
            "ledgerFeedback": ledger_feedback(home),
            # Exact worker identities only. A model-wide command cannot prove
            # the quoted provider, harness, tools, or privacy clearance.
            "runnable": runnable_workers}


def load_workspace(home: Path) -> dict:
    """Load a workspace without ever creating a public model roster."""
    if not (home / "index.sqlite").is_file():
        return setup_payload(home)
    if not (home / "local.sqlite").is_file():
        try:
            owi_do.owi("database", "init", "--index", str(home / "index.sqlite"),
                       "--local", str(home / "local.sqlite"))
        except (Exception, SystemExit) as error:
            return setup_payload(
                home, "A public index was found, but the private ledger could "
                f"not be initialized: {error}"
            )
    try:
        return harvest(home)
    except (Exception, SystemExit) as error:
        return setup_payload(home, str(error))


def prepare_workspace(home: Path, demo: bool) -> dict:
    """Seed examples only when the operator explicitly asked for a demo."""
    if demo:
        owi_do.bootstrap(home)
    return load_workspace(home)


class Handler(BaseHTTPRequestHandler):
    home: Path
    lock = threading.Lock()
    data: dict = {}
    # Every bind, including localhost, is gated. The first page load carries
    # the token once in its URL and exchanges it for a SameSite cookie; API
    # callers may instead use X-OWI-Token. This prevents another local web page
    # from driving a paid runner through a cross-origin form/fetch.
    token: str | None = None
    workflow: WorkflowService | None = None
    github: GitHubManager | None = None

    def _send(self, code: int, body: bytes, kind: str,
              set_cookie: bool = False) -> None:
        self.send_response(code)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        if set_cookie and self.token:
            self.send_header("Set-Cookie",
                             f"owi_token={self.token}; HttpOnly; "
                             "SameSite=Strict; Path=/")
        self.end_headers()
        self.wfile.write(body)

    def _route(self) -> str:
        return self.path.split("?", 1)[0]

    def _authorized(self) -> bool:
        if not self.token:
            return False
        query = parse_qs(urlparse(self.path).query)
        query_token = query.get("token", [None])[0]
        if query_token is not None and hmac.compare_digest(query_token, self.token):
            return True
        header_token = self.headers.get("X-OWI-Token")
        if header_token is not None and hmac.compare_digest(header_token,
                                                            self.token):
            return True
        cookies = SimpleCookie()
        try:
            cookies.load(self.headers.get("Cookie") or "")
        except CookieError:
            return False
        supplied = cookies.get("owi_token")
        return supplied is not None and hmac.compare_digest(supplied.value,
                                                            self.token)

    def _trusted_post_origin(self) -> bool:
        """Browser POSTs must originate from this exact local app origin."""
        fetch_site = (self.headers.get("Sec-Fetch-Site") or "").lower()
        if fetch_site and fetch_site not in ("same-origin", "none"):
            return False
        origin = self.headers.get("Origin")
        if origin is None:
            # Non-browser clients remain possible, but still need the token.
            return True
        if origin == "null":
            return False
        host = self.headers.get("Host")
        return bool(host) and origin == f"http://{host}"

    def _json(self, code: int, payload: dict) -> None:
        self._send(code, json.dumps(payload).encode(), "application/json")

    def _body(self) -> dict | None:
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            return None
        if length <= 0 or length > 1_000_000:
            return None
        try:
            body = json.loads(self.rfile.read(length))
            return body if isinstance(body, dict) else None
        except (UnicodeError, json.JSONDecodeError):
            return None

    def _workflow_service(self) -> WorkflowService:
        if self.workflow is None or self.workflow.home != self.home:
            Handler.workflow = WorkflowService(self.home, owi_do, stored_catalog)
        return Handler.workflow

    def _workflow_reply(self, operation) -> None:
        try:
            payload = operation(self._workflow_service())
        except WorkflowProblem as error:
            self._json(error.status, {"error": str(error)})
            return
        except Exception as error:  # keep a malformed local workspace visible
            self._json(500, {"error": f"workflow failed: {error}"})
            return
        self._json(200, payload)

    def _github_service(self) -> GitHubManager:
        if self.github is None or self.github.home != self.home:
            Handler.github = GitHubManager(self.home, GitHubConfig.load())
        return Handler.github

    def _github_reply(self, operation) -> None:
        try:
            payload = operation(self._github_service())
        except GitHubProblem as error:
            self._json(error.status, {
                "error": str(error), "code": error.code, **error.details
            })
            return
        except WorkflowProblem as error:
            self._json(error.status, {"error": str(error),
                                      "code": "workflow_problem"})
            return
        except Exception:
            # Upstream bodies and credentials are deliberately never reflected.
            self._json(500, {"error": "GitHub Manager failed safely",
                             "code": "manager_failure"})
            return
        self._json(200, payload)

    def do_GET(self) -> None:  # noqa: N802 (stdlib naming)
        if not self._authorized():
            self._json(401, {"error": "missing or wrong token — open "
                                      "/?token=<the token the server printed>"})
            return
        route = self._route()
        if route == "/":
            template = inline_office_assets(
                (TOOLS / "owi_ask_template.html").read_text())
            with self.lock:
                payload = json.dumps(self.data).replace("</", "<\\/")
            page = (template.replace("__DATA__", payload)
                    .replace("__BUILT__", "local — always current"))
            self._send(200, page.encode(), "text/html; charset=utf-8",
                       set_cookie=True)
        elif route == "/api/data":
            with self.lock:
                self._json(200, self.data)
        elif route == "/api/projects/current":
            self._workflow_reply(
                lambda workflow: {"project": workflow.current()}
            )
        elif route == "/api/v1/github/status":
            self._github_reply(lambda manager: manager.status())
        elif route == "/api/v1/github/repositories":
            self._github_reply(lambda manager: manager.list_repositories())
        elif route == "/api/v1/github/work-items":
            query = parse_qs(urlparse(self.path).query)
            repository_id = query.get("repositoryId", [None])[0]
            self._github_reply(
                lambda manager: manager.work_items(repository_id)
            )
        else:
            self._json(404, {"error": "not found"})

    def do_POST(self) -> None:  # noqa: N802
        if not self._authorized():
            self._json(401, {"error": "missing or wrong token"})
            return
        content_type = self.headers.get("Content-Type", "").split(";", 1)[0]
        if content_type.strip().lower() != "application/json":
            self._json(415, {"error": "Content-Type must be application/json"})
            return
        if not self._trusted_post_origin():
            self._json(403, {"error": "cross-origin POST rejected"})
            return
        body = self._body()
        if body is None:
            self._json(400, {"error": "request body must be one JSON object"})
            return
        route = self._route()
        if (match := re.fullmatch(
                r"/api/v1/github/repositories/([0-9]+)/sync", route)):
            if body:
                self._json(400, {"error": "sync body must be an empty JSON object",
                                 "code": "invalid_sync"})
                return
            repository_id = match.group(1)
            # No Handler.lock: outbound GitHub reads must not block Office APIs.
            self._github_reply(lambda manager: manager.sync(repository_id))
        elif (match := re.fullmatch(
                r"/api/v1/github/work-items/([^/]+)/import", route)):
            item_id = unquote(match.group(1))
            self._github_reply(lambda manager: manager.import_item(
                item_id, body, self._workflow_service()
            ))
        elif route == "/api/projects":
            if not self.data.get("configured"):
                self._json(409, {"error": "configure a real OWI workspace first"})
                return
            with self.lock:
                self._workflow_reply(
                    lambda workflow: {"project": workflow.create_project(body)}
                )
        elif (match := re.fullmatch(r"/api/projects/([^/]+)/tasks", route)):
            if not self.data.get("configured"):
                self._json(409, {"error": "configure a real OWI workspace first"})
                return
            project_id = unquote(match.group(1))
            with self.lock:
                self._workflow_reply(lambda workflow: dict(zip(
                    ("project", "task"), workflow.add_task(project_id, body)
                )))
        elif (match := re.fullmatch(r"/api/projects/([^/]+)/staff", route)):
            if not self.data.get("configured"):
                self._json(409, {"error": "configure a real OWI workspace first"})
                return
            project_id = unquote(match.group(1))
            with self.lock:
                self._workflow_reply(lambda workflow: {
                    "project": workflow.staff_project(project_id)
                })
        elif (match := re.fullmatch(
                r"/api/projects/([^/]+)/tasks/([^/]+)/run", route)):
            if not self.data.get("configured"):
                self._json(409, {"error": "configure a real OWI workspace first"})
                return
            project_id, task_id = (unquote(value) for value in match.groups())
            with self.lock:
                def run(workflow):
                    project, task = workflow.run_task(project_id, task_id)
                    if task["status"] in ("accepted", "rejected"):
                        Handler.data = harvest(self.home)
                    return {"project": project, "task": task}
                self._workflow_reply(run)
        elif (match := re.fullmatch(
                r"/api/projects/([^/]+)/tasks/([^/]+)/review", route)):
            if not self.data.get("configured"):
                self._json(409, {"error": "configure a real OWI workspace first"})
                return
            project_id, task_id = (unquote(value) for value in match.groups())
            with self.lock:
                def review(workflow):
                    project, task = workflow.review_task(
                        project_id, task_id, body
                    )
                    Handler.data = harvest(self.home)
                    return {"project": project, "task": task}
                self._workflow_reply(review)
        elif route in ("/api/run", "/api/outcome"):
            self._json(410, {"error":
                "legacy direct execution is disabled; create a project, staff "
                "its persisted tasks, then use that task's run/review endpoint"})
        else:
            self._json(404, {"error": "not found"})

    def do_PATCH(self) -> None:  # noqa: N802
        if not self._authorized():
            self._json(401, {"error": "missing or wrong token"})
            return
        content_type = self.headers.get("Content-Type", "").split(";", 1)[0]
        if content_type.strip().lower() != "application/json":
            self._json(415, {"error": "Content-Type must be application/json"})
            return
        if not self._trusted_post_origin():
            self._json(403, {"error": "cross-origin PATCH rejected"})
            return
        if not self.data.get("configured"):
            self._json(409, {"error": "configure a real OWI workspace first"})
            return
        match = re.fullmatch(
            r"/api/projects/([^/]+)/tasks/([^/]+)", self._route()
        )
        if not match:
            self._json(404, {"error": "not found"})
            return
        project_id, task_id = (unquote(value) for value in match.groups())
        body = self._body()
        if body is None:
            self._json(400, {"error": "request body must be one JSON object"})
            return
        with self.lock:
            self._workflow_reply(lambda workflow: dict(zip(
                ("project", "task"),
                workflow.edit_task(project_id, task_id, body),
            )))

    def do_DELETE(self) -> None:  # noqa: N802
        if not self._authorized():
            self._json(401, {"error": "missing or wrong token"})
            return
        if not self._trusted_post_origin():
            self._json(403, {"error": "cross-origin DELETE rejected"})
            return
        if not self.data.get("configured"):
            self._json(409, {"error": "configure a real OWI workspace first"})
            return
        match = re.fullmatch(
            r"/api/projects/([^/]+)/tasks/([^/]+)", self._route()
        )
        if not match:
            self._json(404, {"error": "not found"})
            return
        project_id, task_id = (unquote(value) for value in match.groups())
        with self.lock:
            self._workflow_reply(lambda workflow: {
                "project": workflow.delete_task(project_id, task_id),
                "deletedTaskId": task_id,
            })

    def log_message(self, fmt: str, *args) -> None:
        # Query strings carry the one-time access token on first load.
        print(f"  {self.command} {self._route()}", file=sys.stderr)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--home", type=Path,
                        help="existing OWI workspace (default: .owi-quick; "
                             "with --demo: .owi-demo)")
    parser.add_argument("--demo", action="store_true",
                        help="explicitly seed and label the repository's "
                             "sample roster; never used by default")
    parser.add_argument("--port", type=int, default=7787)
    parser.add_argument("--host", default="127.0.0.1",
                        help="bind address. The token gate is always on; "
                             "anything except 127.0.0.1 should only face a "
                             "network you trust (home Wi-Fi, Tailscale) — "
                             "this is plain HTTP; never expose it to the "
                             "open internet")
    parser.add_argument("--token", default=None,
                        help="access token (generated if omitted; always "
                             "required, including on localhost)")
    parser.add_argument("--no-open", action="store_true",
                        help="do not open the graphical office in a browser")
    parser.add_argument("--github-owner",
                        help="fixed public GitHub owner to browse read-only; "
                             "may also be set with OWI_GITHUB_OWNER")
    parser.add_argument("--github-token-file", type=Path,
                        help="0600 server-side token file; alternatively set "
                             "OWI_GITHUB_TOKEN (never sent to the browser)")
    parser.add_argument("--github-auth-mode", choices=(
                            "fine_grained_pat", "github_app_user_token"),
                        help="credential semantics; defaults to fine_grained_pat")
    parser.add_argument("--allow-insecure-lan-github", action="store_true",
                        help="explicitly allow private-repository metadata over "
                             "this plain-HTTP app on a non-loopback bind")
    arguments = parser.parse_args()

    home = arguments.home or REPO / (".owi-demo" if arguments.demo
                                     else ".owi-quick")
    Handler.home = home
    Handler.token = arguments.token or secrets.token_urlsafe(24)
    Handler.data = prepare_workspace(home, arguments.demo)
    Handler.workflow = WorkflowService(home, owi_do, stored_catalog)
    try:
        github_config = GitHubConfig.load(
            arguments.github_owner, arguments.github_token_file,
            arguments.github_auth_mode,
        )
    except GitHubProblem as error:
        parser.error(str(error))
    if (arguments.host not in ("127.0.0.1", "localhost", "::1")
            and github_config.token and not arguments.allow_insecure_lan_github):
        parser.error("private GitHub Manager on a non-loopback plain-HTTP bind "
                     "requires --allow-insecure-lan-github")
    Handler.github = GitHubManager(home, github_config)
    recovered = Handler.workflow.recover_interrupted_runs()
    if recovered:
        print(f"recovered {recovered} interrupted workflow run(s)", file=sys.stderr)

    server = ThreadingHTTPServer((arguments.host, arguments.port), Handler)
    local_url = (f"http://127.0.0.1:{server.server_address[1]}/"
                 f"?token={Handler.token}")
    if arguments.host != "127.0.0.1":
        print(f"\ntoken gate ON — from your phone (same network) open:\n"
              f"  http://<this-machine's-address>:{server.server_address[1]}/"
              f"?token={Handler.token}\n"
              "requests without the token are turned away (401).",
              file=sys.stderr)
    state = Handler.data.get("mode", "unconfigured")
    print(f"\nOWI Office: {state}\n"
          f"open   {local_url}\n"
          f"home   {home}\n"
          f"runs   via commands in {home / 'runners.json'}\n"
          f"learns into {home / 'local.sqlite'}\n",
          file=sys.stderr)
    if not arguments.no_open:
        threading.Timer(0.25, webbrowser.open, args=(local_url,)).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
