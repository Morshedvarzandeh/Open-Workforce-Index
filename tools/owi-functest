def group_serve(sweep: Sweep) -> None:
    sweep.start("serve — the access gate and the routes")
    import threading
    import urllib.error
    import urllib.request
    from http.server import ThreadingHTTPServer

    serve_loader = importlib.machinery.SourceFileLoader(
        "owi_serve", str(TOOLS / "owi-serve"))
    serve_spec = importlib.util.spec_from_loader("owi_serve", serve_loader)
    owi_serve = importlib.util.module_from_spec(serve_spec)
    serve_loader.exec_module(owi_serve)

    def status(url: str, headers: dict | None = None) -> int:
        request = urllib.request.Request(url, headers=headers or {})
        try:
            with urllib.request.urlopen(request, timeout=5) as response:
                return response.status
        except urllib.error.HTTPError as error:
            return error.code

    owi_serve.Handler.token = "functest-token"
    owi_serve.Handler.data = {}
    owi_serve.Handler.home = REPO / ".owi-quick"
    server = ThreadingHTTPServer(("127.0.0.1", 0), owi_serve.Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    base = f"http://127.0.0.1:{server.server_address[1]}"

    sweep.expect("no token is turned away", status(f"{base}/api/data"), 401)
    sweep.expect("a wrong token is turned away",
                 status(f"{base}/api/data?token=nope"), 401)
    sweep.expect("the token as a query admits",
                 status(f"{base}/api/data?token=functest-token"), 200)
    sweep.expect("the token in a header admits",
                 status(f"{base}/api/data", {"X-OWI-Token": "functest-token"}),
                 200)
    sweep.expect("the page itself is gated too",
                 status(f"{base}/"), 401)
    owi_serve.Handler.token = None
    sweep.expect("localhost mode stays gate-free",
                 status(f"{base}/api/data"), 200)
    sweep.expect("the page serves in localhost mode", status(f"{base}/"), 200)
    server.shutdown()

    sweep.check("serve spawns no worker of its own",
                "subprocess.run(" not in (TOOLS / "owi-serve").read_text())
    sweep.check("every skill has a role on the serve side",
                set(owi_serve.SKILL_ROLE) == set(owi_do.SKILLS),
                f"missing: {set(owi_do.SKILLS) - set(owi_serve.SKILL_ROLE)}")


def group_roster(sweep: Sweep) -> None:
    sweep.start("roster — priced, staffed, and internally consistent")
    seed = json.loads((REPO / "examples/manager-scenario-seed.json").read_text())
    workers = {w["id"] for w in seed["worker_profiles"]}
    sweep.check("the roster is at least 47 workers", len(workers) >= 47,
                f"got {len(workers)}")
    sweep.check("worker ids are unique",
                len(workers) == len(seed["worker_profiles"]))
    evidence_workers = {e["worker_id"] for e in seed["evidence"]}
    sweep.check("every evidence row names a rostered worker",
                evidence_workers <= workers,
                f"orphans: {sorted(evidence_workers - workers)[:2]}")
    staffed = {s for w in seed["worker_profiles"]
               for s in w["supported_skill_ids"]}
    missing = [s for s in owi_do.SKILLS if s not in staffed]
    sweep.check("every skill in the taxonomy has a worker", not missing,
                f"unstaffed: {missing}")
    sweep.check("every worker declares a configuration digest",
                all(len(w.get("configuration_sha256", "")) == 64
                    for w in seed["worker_profiles"]))
    sweep.check("every worker declares a privacy clearance",
                all(w.get("privacy_clearance") for w in seed["worker_profiles"]))
    cleared = [w["id"] for w in seed["worker_profiles"]
               if w["privacy_clearance"] == "confidential_content"]
    sweep.check("at least one worker is cleared for confidential work",
                bool(cleared), "nobody is cleared")
    sweep.check("every evidence score is a probability",
                all(0.0 <= e["normalized_score"] <= 1.0
                    for e in seed["evidence"]))

    code, out, _ = owi("prices", "--input",
                       str(REPO / "examples/litellm-prices-sample.json"),
                       "--options",
                       str(REPO / "examples/price-import-options.json"),
                       "--dry-run")
    offerings = {o["id"] for o in json.loads(out)["offerings"]} if code == 0 \
        else set()
    offered = {w["offering_id"] for w in seed["worker_profiles"]}
    sweep.check("every rostered offering has a published price",
                offered <= offerings,
                f"unpriced: {sorted(offered - offerings)[:2]}")
    sweep.check("no offering id repeats its provider segment",
                not any(f"/{p}/" in o for o in offerings
                        for p in ("gemini", "xai", "deepseek", "mistral")))


