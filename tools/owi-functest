def group_escalation(sweep: Sweep) -> None:
    sweep.start("escalation — who takes the next attempt")
    eligible = [{"worker_id": "worker:cheap/text"},
                {"worker_id": "worker:mid/text"},
                {"worker_id": "worker:best/text"}]

    def runnable(models):
        return lambda model: model in models

    got = owi_do.next_attempt_candidate(eligible, [],
                                        runnable({"cheap", "mid", "best"}))
    sweep.expect("the first attempt goes to the cheapest runnable",
                 got["worker_id"], "worker:cheap/text")
    got = owi_do.next_attempt_candidate(eligible, ["worker:cheap/text"],
                                        runnable({"cheap", "mid", "best"}),
                                        {"worker_id": "worker:best/text"})
    sweep.expect("a retry escalates to the quality option",
                 got["worker_id"], "worker:best/text")
    got = owi_do.next_attempt_candidate(eligible, ["worker:cheap/text"],
                                        runnable({"cheap", "mid"}),
                                        {"worker_id": "worker:best/text"})
    sweep.expect("an unrunnable quality option is skipped",
                 got["worker_id"], "worker:mid/text")
    got = owi_do.next_attempt_candidate(
        eligible, ["worker:cheap/text", "worker:mid/text",
                   "worker:best/text"], runnable({"cheap", "mid", "best"}))
    sweep.check("when everyone has been tried, nobody is offered", got is None)
    got = owi_do.next_attempt_candidate(eligible, [], runnable(set()))
    sweep.check("with nothing runnable, nobody is offered", got is None)

    sweep.start("role ladders — spec from the top, judging from the bottom")
    sweep.expect("the smartest writer leads", owi_do.WRITER_ORDER[0], "opus-5")
    sweep.expect("the cheapest judge leads", owi_do.JUDGE_ORDER[0], "gpt-5-mini")
    sweep.check("the ladders are opposite ends of one roster",
                set(owi_do.WRITER_ORDER) == set(owi_do.JUDGE_ORDER))
    sweep.check("a judge is never the maker",
                owi_do.judge_model_for(REPO / ".owi-quick", exclude="haiku-4-5")
                != "haiku-4-5")


def group_evidence(sweep: Sweep) -> None:
    sweep.start("evidence import — measured ability, stated provenance")
    payload = str(REPO / "examples/battery-core-bench-results.json")
    options = str(REPO / "examples/evidence-import-options.json")
    code, out, _ = owi("evidence", "--input", payload, "--options", options,
                       "--dry-run")
    sweep.check("a dry-run import exits 0", code == 0)
