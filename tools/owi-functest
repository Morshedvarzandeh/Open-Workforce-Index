#!/usr/bin/env python3
"""owi-functest — a broad functional sweep of everything the product does.

    tools/owi-functest              # full sweep
    tools/owi-functest --group cli  # one group

Different job from `owi-selftest`. The frozen suite pins behaviour that was
paid for by a real failure and must never regress. This sweep asks a wider,
shallower question: does every surface still *work* — every CLI subcommand,
every skill route, every checklist kind, every privacy level, every blame
path, the team benchmark, the importers, the page's arithmetic, and the error
paths that are supposed to refuse.

No model is ever called. Execution paths are exercised with stub runners
(`true`, `echo`, `cat`), so the sweep is free, deterministic, and safe to run
as often as you like.
"""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import subprocess
import sys
import tempfile
from pathlib import Path

TOOLS = Path(__file__).resolve().parent
REPO = TOOLS.parent
sys.path.insert(0, str(TOOLS))

_loader = importlib.machinery.SourceFileLoader("owi_do", str(TOOLS / "owi-do"))
_spec = importlib.util.spec_from_loader("owi_do", _loader)
owi_do = importlib.util.module_from_spec(_spec)
_loader.exec_module(owi_do)
import owi_runner  # noqa: E402


class Sweep:
    def __init__(self) -> None:
        self.results: list[tuple[str, str, bool, str]] = []
        self.group = ""

    def start(self, group: str) -> None:
        self.group = group
        print(f"\n{group}")

    def check(self, name: str, ok: bool, note: str = "") -> bool:
        self.results.append((self.group, name, bool(ok), note))
        print(f"  [{'ok' if ok else 'FAIL'}] {name}"
              + (f"  — {note}" if not ok and note else ""))
        return bool(ok)

    def expect(self, name: str, got, want) -> bool:
        return self.check(name, got == want, f"got {got!r}, want {want!r}")

    @property
    def passed(self) -> int:
        return sum(1 for *_, ok, _ in self.results if ok)

    @property
    def failed(self) -> list[tuple[str, str, str]]:
        return [(g, n, note) for g, n, ok, note in self.results if not ok]


def owi(*args: str, expect_ok: bool = True) -> tuple[int, str, str]:
    done = subprocess.run(
        ["cargo", "run", "-q", "-p", "workforce-cli", "--", *args],
        cwd=REPO, capture_output=True, text=True)
    return done.returncode, done.stdout, done.stderr


def build_index(home: Path) -> tuple[Path, Path]:
    index, local = home / "index.sqlite", home / "local.sqlite"
    owi("prices", "--index", str(index),
        "--input", str(REPO / "examples/litellm-prices-sample.json"),
        "--options", str(REPO / "examples/price-import-options.json"))
    owi("seed", "--index", str(index),
        "--input", str(REPO / "examples/manager-scenario-seed.json"))
    owi("database", "init", "--index", str(index), "--local", str(local))
    return index, local


