def group_cli(sweep: Sweep) -> None:
    sweep.start("CLI surface — every subcommand answers, and refuses correctly")
    for command in ("quote", "seed", "allocate", "prices", "snapshot",
                    "evidence", "outcome", "learn", "ontology", "database"):
        code, _, _ = owi(command, "--help")
        sweep.check(f"`owi {command} --help` exits 0", code == 0)

    code, out, _ = owi("ontology", "validate")
    sweep.check("ontology validates", code == 0)

    with tempfile.TemporaryDirectory() as scratch:
        home = Path(scratch)
        index, local = home / "i.sqlite", home / "l.sqlite"
        code, out, _ = owi("database", "init", "--index", str(index),
                           "--local", str(local))
        sweep.check("database init exits 0", code == 0)
        sweep.check("database init creates the public index", index.exists())
        sweep.check("database init creates the private ledger", local.exists())

        code, out, _ = owi("prices", "--index", str(index), "--input",
                           str(REPO / "examples/litellm-prices-sample.json"),
                           "--options",
                           str(REPO / "examples/price-import-options.json"))
        sweep.check("prices import exits 0", code == 0)
        priced = json.loads(out) if code == 0 else {}
        sweep.check("prices import reports offerings",
                    priced.get("imported_provider_offerings", 0) >= 16,
                    f"got {priced.get('imported_provider_offerings')}")
        sweep.check("prices import records a payload digest",
                    len(priced.get("artifact_sha256", "")) == 64)

        code, out, _ = owi("seed", "--index", str(index), "--input",
                           str(REPO / "examples/manager-scenario-seed.json"))
        sweep.check("seed exits 0", code == 0)
        seeded = json.loads(out) if code == 0 else {}
        sweep.check("seed names its snapshot",
                    seeded.get("snapshot_id", "").startswith("snapshot:"))
        sweep.check("seed content digest is a sha256",
                    len(seeded.get("content_sha256", "")) == 64)

        code, _, _ = owi("quote", "--input",
                         str(REPO / "examples/quote-request.json"))
        sweep.check("quote answers a text request", code == 0)
        code, _, _ = owi("quote", "--input",
                         str(REPO / "examples/cad-quote-request.json"))
        sweep.check("quote answers a CAD request", code == 0)
        code, _, _ = owi("learn", "--input",
                         str(REPO / "examples/learning-request.json"))
        sweep.check("learn demonstrates an update", code == 0)

        # allocation-request.json quotes snapshot:example-v1, which belongs
        # to index-seed.json — a decision names the snapshot it was made
        # against, and the index must hold that exact one.
        code, _, _ = owi("allocate", "--index", str(index), "--local",
                         str(local), "--input",
                         str(REPO / "examples/allocation-request.json"))
        sweep.check("a decision quoting an unknown snapshot is refused",
                    code != 0)
        owi("seed", "--index", str(index),
            "--input", str(REPO / "examples/index-seed.json"))
        code, out, _ = owi("allocate", "--index", str(index), "--local",
                           str(local), "--input",
                           str(REPO / "examples/allocation-request.json"))
        sweep.check("allocate answers once its snapshot exists", code == 0)
        quoted = json.loads(out) if code == 0 else {}
        sweep.check("allocate names a selected worker",
                    (quoted.get("quote") or {}).get("selected_worker_id"))
        sweep.check("allocate explains who was turned away",
                    "rejected_candidates" in (quoted.get("quote") or {}))

        # Error paths: the product must refuse, not guess.
        code, _, err = owi("seed", "--index", str(index),
                           "--input", str(home / "does-not-exist.json"))
        sweep.check("a missing input file is refused", code != 0)
        bad = home / "bad.json"
        bad.write_text("{ not json")
        code, _, _ = owi("quote", "--input", str(bad))
        sweep.check("unparseable JSON is refused", code != 0)
        code, _, _ = owi("evidence", "--input",
                         str(REPO / "examples/battery-core-bench-results.json"),
                         "--options", str(bad), "--dry-run")
        sweep.check("unparseable options are refused", code != 0)


def group_snapshot(sweep: Sweep) -> None:
    sweep.start("snapshots — a closed set, cut on demand")
    with tempfile.TemporaryDirectory() as scratch:
        home = Path(scratch)
        index, _ = build_index(home)
        code, out, _ = owi("snapshot", "--index", str(index),
                           "--id", "snapshot:functest-1",
                           "--created-at", "2026-08-21T00:00:00Z")
        sweep.check("snapshot exits 0", code == 0)
        cut = json.loads(out) if code == 0 else {}
        sweep.expect("snapshot keeps the id it was given",
                     cut.get("snapshot_id"), "snapshot:functest-1")
        sweep.check("snapshot carries the previous one forward",
                    cut.get("previous_snapshot_id") is not None)
        members = cut.get("members", {})
        for kind, least in (("model_releases", 1), ("provider_offerings", 16),
                            ("worker_profiles", 43), ("evidence", 40)):
            sweep.check(f"snapshot holds {least}+ {kind}",
                        members.get(kind, 0) >= least,
                        f"got {members.get(kind)}")
        # Append-only: the same id must never be re-cut.
        code, _, _ = owi("snapshot", "--index", str(index),
                         "--id", "snapshot:functest-1",
                         "--created-at", "2026-08-21T00:00:00Z")
        sweep.check("re-cutting an existing snapshot id is refused", code != 0)


def group_classify(sweep: Sweep) -> None:
    sweep.start("skill routing — plain words reach the right bench")
    cases = [
        ("Rewrite this email to the supplier", "skill:text-editing"),
        ("Summarize these notes into a short update", "skill:text-editing"),
        ("Extract the invoice fields into json", "skill:structured-extraction"),
        ("Parse this csv table into structured records",
         "skill:structured-extraction"),
        ("Implement the python function and fix the failing test",
         "skill:python-numerical-implementation"),
        ("Refactor the rust module so cargo compiles",
         "skill:python-numerical-implementation"),
        ("Model a parametric bracket and export step",
         "skill:parametric-cad"),
        ("Design the enclosure geometry as a 3d model",
         "skill:parametric-cad"),
        ("Write the roadmap and decompose it into milestones",
         "skill:planning-decomposition"),
        ("Draft the architecture strategy and design doc",
         "skill:planning-decomposition"),
        ("Debug the failing regression from this stack trace",
         "skill:code-review-debugging"),
        ("Diagnose the root cause, why does it break",
         "skill:code-review-debugging"),
        ("Design the landing page layout and css", "skill:ui-design"),
        ("Sketch a ux wireframe and mockup", "skill:ui-design"),
    ]
    for text, want in cases:
        sweep.expect(f"{text[:44]!r}", owi_do.classify(text), want)
    sweep.expect("an unrecognisable request falls back to text",
                 owi_do.classify("zzz qqq"), owi_do.DEFAULT_SKILL)
    sweep.check("every skill in the taxonomy is reachable",
                {want for _, want in cases} == set(owi_do.SKILLS),
                f"unreachable: {set(owi_do.SKILLS) - {w for _, w in cases}}")


def group_checklist(sweep: Sweep) -> None:
    sweep.start("checklist engine — every kind, both verdicts")
    cases = [
        ("contains:thermal", "the thermal margin held", "contains", True),
        ("contains:thermal", "nothing relevant here", "contains", False),
        ("contains:'quoted'", "a quoted word", "contains", True),
        ('contains:"double"', "a double word", "contains", True),
        ("regex:40\\s*A", "rated 40 A today", "regex", True),
        ("regex:40\\s*A", "rated 12 V today", "regex", False),
        ("regex:[unclosed", "anything", "regex", None),
        ("json", '{"a": 1}', "json", True),
        ("json", 'prose with {"a": 1} inside', "json", True),
        ("json", "no object here", "json", False),
        ("min-words:3", "one two three", "min-words", True),
        ("min-words:5", "one two three", "min-words", False),
        ("min-words:notanumber", "one two", "min-words", None),
        ("python", "def f():\n    return 1\n", "python", True),
        ("python", "def f(:\n", "python", False),
        ("explains the tradeoff clearly", "anything", "judged", None),
    ]
    for item, output, want_kind, want_verdict in cases:
        kind, verdict, _ = owi_do.check_item(item, output)
        sweep.expect(f"{want_kind}: {item[:34]!r}", verdict, want_verdict)
        sweep.expect(f"  labelled {want_kind}", kind, want_kind)

    with tempfile.TemporaryDirectory() as scratch:
        report = owi_do.run_checklist(
            Path(scratch), "probe", "the thermal margin held",
            ["contains:thermal", "min-words:3"], maker_model="none",
            judge_enabled=False)
        sweep.expect("all mechanical items passing accepts",
                     report["verdict"], "accepted")
        report = owi_do.run_checklist(
            Path(scratch), "probe", "nothing",
            ["contains:thermal"], maker_model="none", judge_enabled=False)
        sweep.expect("a failed mechanical item rejects",
                     report["verdict"], "rejected")


def group_privacy(sweep: Sweep) -> None:
    sweep.start("confidentiality — a gate, not a preference")
    ladder = ["public", "private_metadata", "confidential_content", "secret"]
    for plain, formal in owi_do.PRIVACY.items():
        sweep.check(f"'{plain}' maps onto the domain ladder",
                    formal in ladder, f"got {formal}")
    with tempfile.TemporaryDirectory() as scratch:
        home = Path(scratch)
        index, local = build_index(home)
        for level, expect_cleared_only in (("private_metadata", False),
                                           ("confidential_content", True)):
            request = home / f"req-{level}.json"
            request.write_text(json.dumps({
                "decision_id": f"decision:ft-{level}",
                "snapshot_id": "snapshot:manager-scenario-v1",
                "at_epoch_ms": owi_do.AT_EPOCH_MS,
                "created_at": "2026-08-21T00:00:00Z",
                "task": {"id": f"task:ft-{level}", "summary": "probe",
                         "required_skills": [{
                             "skill_id": "skill:text-editing",
                             "minimum_success_probability": 0.24,
                             "minimum_evidence_count": 0}],
                         "required_tools": [], "privacy": level,
                         "risk": "low", "verification": "deterministic",
                         "minimum_success_probability": 0.24,
                         "minimum_evidence_count": 0,
                         "estimated_input_tokens": 2000,
                         "estimated_output_tokens": 800},
                "policy": {"policy_id": "policy:economy-v1",
                           "currency": "USD",
                           "quota_shadow_cash_micros_per_unit": 0,
                           "failure_probability_basis": "mean",
                           "max_attempts": 2},
                "calibration": {"calibration_id": "calibration:v1",
                                "confidence_tail_probability": 0.05,
                                "prior_alpha": 1.0, "prior_beta": 1.0,
                                "max_public_prior_weight": 8.0,
                                "private_outcome_weight": 1.0},
                "assumptions": {"default_p95_latency_ms": 30000},
            }))
            code, out, _ = owi("allocate", "--index", str(index),
                               "--local", str(local), "--input", str(request))
            staffed = {c["worker_id"] for c in
                       json.loads(out)["quote"]["eligible_candidates"]} \
                if code == 0 else set()
            if expect_cleared_only:
                sweep.expect("a confidential task staffs only cleared workers",
                             staffed, {"worker:local-llama/text"})
            else:
                sweep.check("an ordinary task staffs the cloud roster",
                            len(staffed) > 1, f"got {len(staffed)}")

    # Redaction: a confidential failure leaves statistics, never content.
    with tempfile.TemporaryDirectory() as scratch:
        home = Path(scratch)
        owi_do.log_root_cause(home, "the secret recipe", "worker:x/text",
                              "skill:text-editing", "worker", "leaked detail",
                              privacy="confidential_content")
        entry = json.loads((home / "root-causes.jsonl").read_text())
        sweep.expect("confidential task text is redacted",
                     entry["task"], "[redacted]")
        sweep.expect("confidential failure detail is dropped",
                     entry["detail"], "")
        sweep.check("the statistics survive redaction",
                    entry["worker"] == "worker:x/text"
                    and entry["cause"] == "worker")
        sweep.expect("a redacted entry is never replayed as prevention",
                     owi_do.prevention_notes(home, "skill:text-editing"), [])


def group_runner(sweep: Sweep) -> None:
    sweep.start("runner contract — whose failure was it")
    cases = [
        ("real output belongs to the worker", "echo hello",
         owi_runner.WORKER, True),
        ("silence is the environment", "true",
         owi_runner.ENVIRONMENT, False),
        ("whitespace-only output is still silence", "echo '   '",
         owi_runner.ENVIRONMENT, False),
        ("a non-zero exit is the environment", "echo out; exit 3",
         owi_runner.ENVIRONMENT, False),
        ("a missing program is the environment", "/no-such-runner-binary",
         owi_runner.ENVIRONMENT, False),
    ]
    for name, command, want_blame, want_usable in cases:
        result = owi_runner.run_worker(command, "task text", timeout=10)
        sweep.expect(name, result.blame, want_blame)
        sweep.expect(f"  usable={want_usable}", result.usable, want_usable)
    timed = owi_runner.run_worker("sleep 30", "task", timeout=1)
    sweep.expect("a timeout is the environment", timed.blame,
                 owi_runner.ENVIRONMENT)
    sweep.check("an unusable result carries no output", timed.output == "")

    piped = owi_runner.run_worker("cat", "the whole task on stdin", timeout=10)
    sweep.expect("the task travels on stdin", piped.output.strip(),
                 "the whole task on stdin")

    where = owi_runner.run_worker("pwd", "", timeout=10)
    sweep.check("a worker runs somewhere real", where.usable)
    sweep.expect("a worker inherits no standing instructions",
                 owi_runner.instruction_files_above(Path(where.output.strip())),
                 [])
    sweep.check("this repo would otherwise impose instructions",
                bool(owi_runner.instruction_files_above(REPO / ".owi-quick")))

    with tempfile.TemporaryDirectory() as scratch:
        home = Path(scratch)
        (home / "runners.json").write_text('{"m": "echo configured"}')
        sweep.expect("a configured runner wins",
                     owi_runner.resolve(home, "m", {"m": "echo builtin"}),
                     "echo configured")
        sweep.expect("an unset model falls back to a built-in that exists",
                     owi_runner.resolve(home, "n", {"n": "echo builtin"}),
                     "echo builtin")
        sweep.expect("a built-in whose CLI is absent is not offered",
                     owi_runner.resolve(home, "p",
                                        {"p": "no-such-cli --run"}), None)
        sweep.expect("an unknown model has no runner",
                     owi_runner.resolve(home, "q", {}), None)
        (home / "runners.json").write_text("{ broken")
        try:
            owi_runner.load_runners(home)
            sweep.check("a corrupt runners.json is reported", False,
                        "it was silently ignored")
        except SystemExit:
            sweep.check("a corrupt runners.json is reported, not ignored", True)


def group_blame_end_to_end(sweep: Sweep) -> None:
    sweep.start("blame end to end — plumbing never becomes evidence")
    with tempfile.TemporaryDirectory() as scratch:
        home = Path(scratch)
        owi_do.bootstrap(home)
        import sqlite3

        def last_outcome() -> dict:
            connection = sqlite3.connect(home / "local.sqlite")
            row = connection.execute(
                "SELECT accepted, metadata_json FROM outcome_events "
                "ORDER BY rowid DESC LIMIT 1").fetchone()
            connection.close()
            return {"accepted": row[0], "meta": json.loads(row[1] or "{}")}

        for label, command, want_cause in (
                ("empty output", "true", "environment"),
                ("non-zero exit", "echo out; exit 4", "environment")):
            (home / "runners.json").write_text(
                json.dumps({"gpt-5-mini": command}))
            verdict, _ = owi_do.attempt_run(
                home, "worker:gpt-5-mini/text", "gpt-5-mini",
                "skill:text-editing", f"functest {label}", "",
                ["contains:anything"], None, None,
                {"level": "full", "judge": False}, [])
            record = last_outcome()
            sweep.expect(f"{label} is rejected", verdict, "rejected")
            sweep.expect(f"{label} blames the environment",
                         record["meta"].get("root_cause"), want_cause)
            sweep.check(f"{label} is never checked against a checklist",
                        "checklist" not in record["meta"])

        (home / "runners.json").write_text(
            json.dumps({"gpt-5-mini": "echo the thermal margin held"}))
        verdict, _ = owi_do.attempt_run(
            home, "worker:gpt-5-mini/text", "gpt-5-mini",
            "skill:text-editing", "functest real output", "",
            ["contains:thermal"], None, None,
            {"level": "full", "judge": False}, [])
        sweep.expect("real output is checked and can be accepted",
                     verdict, "accepted")
        sweep.check("an accepted run records its checklist",
                    "checklist" in last_outcome()["meta"])


