        code, out, _ = owi("evidence", "--input", str(skewed),
                           "--options", options, "--dry-run")
        result = json.loads(out) if code == 0 else {}
        sweep.expect("an impossible score imports nothing",
                     result.get("imported_evidence"), 0)
        sweep.expect("and is reported as skipped",
                     len(result.get("skipped", [])), 2)

        narrowed = home / "narrow.json"
        narrowed.write_text(json.dumps({
            "adapter_version": "leaderboard@1",
            "source_url": "https://example.test/board",
            "retrieved_at": "2026-08-21T00:00:00Z",
            "evidence_tier": "vendor_reported", "license": "CC0-1.0",
            "benchmark_id": "benchmark:functest",
            "skill_id": "skill:python-numerical-implementation",
            "metric": "pass_rate", "unit": "percent", "score_scale": 100.0,
            "include_models": ["claude-opus-5"]}))
        code, out, _ = owi("evidence", "--input", payload,
                           "--options", str(narrowed), "--dry-run")
        narrow = json.loads(out) if code == 0 else {}
        sweep.expect("include_models narrows the import",
                     narrow.get("imported_evidence"), 1)
        sweep.expect("an unrequested model is skipped, not imported",
                     len(narrow.get("skipped", [])), 3)


def group_bench(sweep: Sweep) -> None:
    sweep.start("bench harness — calibration, blame, and identity")
    adapter_loader = importlib.machinery.SourceFileLoader(
        "bench_chat_adapter", str(TOOLS / "bench_chat_adapter.py"))
    adapter_spec = importlib.util.spec_from_loader(
        "bench_chat_adapter", adapter_loader)
    adapter = importlib.util.module_from_spec(adapter_spec)
    adapter_loader.exec_module(adapter)

    for name, reply, want in (
            ("a restated signature is stripped",
             "def f(x):\n    return x + 1\n", "    return x + 1"),
            ("a bare body is indented in", "return x\n", "    return x"),
            ("a nested helper keeps its header",
             "    def h(v):\n        return v\n\n    return h(x)\n",
             "    def h(v):\n        return v\n\n    return h(x)"),
            ("a fenced reply is unwrapped",
             "```python\n    return x\n```", "    return x"),
            ("prose around a fence is discarded",
             "Sure:\n```python\n    return x\n```\nDone.", "    return x")):
        sweep.expect(name, adapter.extract_body(reply, "    ", "f"), want)
    sweep.expect("an empty reply yields no body",
                 adapter.extract_body("", "    ", "f"), "")

    with tempfile.TemporaryDirectory() as scratch:
        area = Path(scratch)
        repo, out = area / "repo", area / "out"
        repo.mkdir()
        (repo / "unit.py").write_text("def f():\n    return 1\n")
        corpus = {
            "corpus_id": "corpus:functest", "commit": "HEAD",
            "skill_id": "skill:python-numerical-implementation",
            "verify_command": [
                "python3", "-c",
                "import sys; sys.path.insert(0, '.'); import unit; "
                "sys.exit(0 if unit.f() == 1 else 1)"],
            "tasks": [{"task_id": "task:functest:f", "qualified_name": "f",
                       "source_path": "unit.py", "instruction": "implement f",
                       "signature": "def f():", "docstring": "one",
                       "indent": "    ",
                       "patch": {"file": "unit.py", "start_line": 2,
                                 "end_line": 2,
                                 "stub": "    raise NotImplementedError"}}]}
        corpus_path = area / "corpus.json"
        corpus_path.write_text(json.dumps(corpus))

        def run_bench(*extra: str, outcome_dir: Path | None = None,
                      report: Path | None = None):
            argv = [sys.executable, str(TOOLS / "run_bench.py"),
                    "--corpus", str(corpus_path), "--repo", str(repo),
                    "--worker-id", "worker:functest/code",
                    "--observed-at", "2026-08-21T00:00:00Z", *extra]
            if outcome_dir:
                argv += ["--outcome-dir", str(outcome_dir)]
            argv += ["--report", str(report or (area / "r.json"))]
            done = subprocess.run(argv, capture_output=True, text=True)
            data = json.loads(report.read_text()) if report \
                and report.exists() else {}
            return done.returncode, data

        code, data = run_bench("--adapter", "stub", outcome_dir=out,
                               report=area / "stub.json")
        sweep.expect("the stub adapter scores zero", data.get("accepted"), 0)
        sweep.expect("and every stub task is scored", data.get("scored"), 1)
        sweep.expect("a stub failure blames the worker",
                     data.get("unscored_harness_failures"), 0)
        sweep.check("a worker-blamed failure IS recorded",
                    len(list(out.glob("*.json"))) == 1)

        broken = area / "broken"
        code, data = run_bench("--adapter", "command",
                               "--command", "/no-such-adapter",
                               outcome_dir=broken, report=area / "b.json")
        sweep.expect("a missing adapter is a harness failure",
                     data.get("unscored_harness_failures"), 1)
        sweep.expect("and nothing is scored", data.get("scored"), 0)
        sweep.check("a harness failure records NOTHING against the worker",
                    not broken.exists() or not list(broken.glob("*.json")))
        sweep.check("a run that measured nothing exits non-zero", code != 0)

        first, second = area / "one", area / "two"
        run_bench("--adapter", "stub", outcome_dir=first,
                  report=area / "1.json")
        argv_two = [sys.executable, str(TOOLS / "run_bench.py"),
                    "--corpus", str(corpus_path), "--repo", str(repo),
                    "--worker-id", "worker:functest/code",
                    "--adapter", "stub",
                    "--observed-at", "2026-09-09T00:00:00Z",
                    "--outcome-dir", str(second), "--report",
                    str(area / "2.json")]
        subprocess.run(argv_two, capture_output=True, text=True)
        ids_one = {json.loads(p.read_text())["event"]["id"]
                   for p in first.glob("*.json")}
        ids_two = {json.loads(p.read_text())["event"]["id"]
                   for p in second.glob("*.json")}
        sweep.check("two runs of one worker produce distinct ids",
                    ids_one and ids_two and not (ids_one & ids_two))
        sweep.check("an outcome id names the run it came from",
                    all("@2026-08-21T00:00:00Z" in i for i in ids_one))


