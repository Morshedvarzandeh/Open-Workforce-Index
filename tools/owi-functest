    "evidence": group_evidence,
    "bench": group_bench,
    "team": group_team,
    "page": group_page,
    "serve": group_serve,
    "roster": group_roster,
}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--group", action="append", choices=sorted(GROUPS),
                        help="run only these groups (repeatable)")
    arguments = parser.parse_args()

    sweep = Sweep()
    chosen = arguments.group or list(GROUPS)
    print(f"owi functional sweep — {len(chosen)} groups, no model calls")
    for name in chosen:
        try:
            GROUPS[name](sweep)
        except Exception as error:  # a crashed group is itself a failure
            sweep.start(name)
            sweep.check(f"the {name} group ran to completion", False,
                        f"{type(error).__name__}: {error}")

    total = len(sweep.results)
    print(f"\n{'=' * 62}")
    by_group: dict[str, list[bool]] = {}
    for group, _, ok, _ in sweep.results:
        by_group.setdefault(group.split(" —")[0], []).append(ok)
    for group, outcomes in by_group.items():
        print(f"  {sum(outcomes):>3}/{len(outcomes):<3} {group}")
    print(f"{'=' * 62}")
    print(f"functional sweep: {sweep.passed}/{total} passed")
    if sweep.failed:
        print(f"\n{len(sweep.failed)} failing:")
        for group, name, note in sweep.failed:
            print(f"  - [{group.split(' —')[0]}] {name}"
                  + (f" — {note}" if note else ""))
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
