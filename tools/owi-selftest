#!/usr/bin/env python3
"""owi-selftest — the frozen high-level suite.

    tools/owi-selftest                      # full suite (needs cargo)
    tools/owi-selftest --no-cargo           # engine-only, no build step

As the loop gets more automated, this is the brake: the expectations in
examples/frozen-checks-v*.json are pinned versions of behaviour that already
worked — prices that imported exactly, the roster that staffed, the check
engine's verdicts, the planner's validation, the prevention filter. Any change
that would lose them fails here first, not in a live run.

The checklist file is evolutionary: lived failures get frozen into it as new
fixtures (with provenance), and the version bumps. This runner never calls a
model and never touches the network — everything it checks is deterministic.
"""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import subprocess
import sys
import tempfile
from pathlib import Path

TOOLS = Path(__file__).resolve().parent
REPO = TOOLS.parent

_loader = importlib.machinery.SourceFileLoader("owi_do", str(TOOLS / "owi-do"))
_spec = importlib.util.spec_from_loader("owi_do", _loader)
owi_do = importlib.util.module_from_spec(_spec)
_loader.exec_module(owi_do)


class Suite:
    def __init__(self) -> None:
        self.passed = 0
        self.failed: list[str] = []

    def check(self, name: str, ok: bool, note: str = "") -> None:
        if ok:
            self.passed += 1
        else:
            self.failed.append(f"{name}{' — ' + note if note else ''}")
        print(f"  [{'ok' if ok else 'FAIL'}] {name}")


def run(no_cargo: bool) -> int:
    frozen = json.loads(
        (REPO / "examples/frozen-checks-v1.json").read_text())
    suite = Suite()
    print(f"frozen suite: {frozen['version']} (frozen {frozen['frozen_at']})")

    print("\ncheck engine")
    for fixture in frozen["check_engine_fixtures"]:
        kind, verdict, _ = owi_do.check_item(fixture["item"], fixture["output"])
        want = fixture["expect"]
        suite.check(
            f"{fixture['kind']}: {fixture['item'][:44]!r}",
            verdict is want if want is None else verdict == want,
            f"got {verdict!r}, want {want!r}")
        suite.check(f"  labelled {fixture['kind']}", kind == fixture["kind"],
                    f"got {kind!r}")

    print("\nplanner validation")
    for position, fixture in enumerate(frozen["planner_fixtures"], start=1):
        cleaned = owi_do.clean_parts(fixture["raw"])
        want = fixture["expect_parts"]
        got = None if cleaned is None else len(cleaned)
        suite.check(f"planner fixture {position}", got == want,
                    f"got {got!r}, want {want!r}")

    gate = frozen.get("serve_gate_expectations")
    if gate:
        print("\nserve access gate")
        import threading
        import urllib.error
        import urllib.request
        from http.server import ThreadingHTTPServer
        serve_loader = importlib.machinery.SourceFileLoader(
            "owi_serve", str(TOOLS / "owi-serve"))
        serve_spec = importlib.util.spec_from_loader("owi_serve", serve_loader)
        owi_serve = importlib.util.module_from_spec(serve_spec)
        serve_loader.exec_module(owi_serve)

        def status(url: str, headers: dict | None = None) -> int:
            request = urllib.request.Request(url, headers=headers or {})
            try:
                with urllib.request.urlopen(request, timeout=5) as response:
                    return response.status
            except urllib.error.HTTPError as error:
                return error.code

        owi_serve.Handler.token = "frozen-suite-token"
        owi_serve.Handler.data = {}
        server = ThreadingHTTPServer(("127.0.0.1", 0), owi_serve.Handler)
        threading.Thread(target=server.serve_forever, daemon=True).start()
        base = f"http://127.0.0.1:{server.server_address[1]}"
        want = gate["unauthorized_status"]
        suite.check("a request without the token is turned away",
                    status(f"{base}/api/data") == want)
        suite.check("the token in a header admits",
                    status(f"{base}/api/data",
                           {"X-OWI-Token": "frozen-suite-token"}) == 200)
        suite.check("the token as a query admits",
                    status(f"{base}/api/data?token=frozen-suite-token") == 200)
        owi_serve.Handler.token = None
        suite.check("localhost mode stays gate-free",
                    status(f"{base}/api/data") == 200)
        server.shutdown()

    qc = frozen.get("qc_expectations")
    if qc:
        print("\nquality control (lean inspection contract)")
        suite.check(f"clearance is {qc['clearance']} clean accepts",
                    owi_do.QC["clearance"] == qc["clearance"],
                    f"got {owi_do.QC['clearance']}")
        suite.check(f"sampling is 1-in-{qc['sample_every']} once cleared",
                    owi_do.QC["sample_every"] == qc["sample_every"],
                    f"got {owi_do.QC['sample_every']}")
        for position, fixture in enumerate(
                frozen.get("sampling_fixtures", []), start=1):
            with tempfile.TemporaryDirectory() as scratch:
                report = owi_do.run_checklist(
                    Path(scratch), "frozen-suite probe", fixture["output"],
                    fixture["items"], maker_model="none",
                    judge_enabled=False)
            suite.check(f"sampling fixture {position}",
                        report["verdict"] == fixture["expect_verdict"],
                        f"got {report['verdict']!r}")
        with tempfile.TemporaryDirectory() as scratch:
            level = owi_do.inspection_for(Path(scratch), "worker:x/text",
                                          "skill:text-editing")
        suite.check("a worker with no history starts at full inspection",
                    level["level"] == "full" and level["judge"],
                    f"got {level!r}")

    roles = frozen.get("role_order_expectations")
    if roles:
        print("\nrole ladders (spec from the top, judging from the bottom)")
        suite.check("checklist writers are smartest-first",
                    owi_do.WRITER_ORDER[:2] == roles["writer_head"],
                    f"got {owi_do.WRITER_ORDER[:2]}")
        suite.check("judges are cheapest-first",
                    owi_do.JUDGE_ORDER[:2] == roles["judge_head"],
                    f"got {owi_do.JUDGE_ORDER[:2]}")

    print("\nauto-checklist cleaning")
    for position, fixture in enumerate(
            frozen.get("auto_checklist_fixtures", []), start=1):
        got = owi_do.clean_checklist(fixture["raw"])
        suite.check(f"auto-checklist fixture {position}",
                    got == fixture["expect"], f"got {got!r}")

    print("\nescalation (iterate-until-verified)")
    for position, fixture in enumerate(
            frozen.get("escalation_fixtures", []), start=1):
        eligible = [{"worker_id": w} for w in fixture["eligible"]]
        runnable_models = {w.split(":")[1].split("/")[0]
                           for w in fixture["runnable"]}
        prefer = ({"worker_id": fixture["prefer"]}
                  if fixture["prefer"] else None)
        got = owi_do.next_attempt_candidate(
            eligible, fixture["tried"],
            lambda model: model in runnable_models, prefer)
        got_id = got["worker_id"] if got else None
        suite.check(f"escalation fixture {position}",
                    got_id == fixture["expect"],
                    f"got {got_id!r}, want {fixture['expect']!r}")

    cwd_rule = frozen.get("runner_cwd_expectations")
    if cwd_rule:
        print("\nrunner working directory (a scratch dir that inherits nothing)")
        with tempfile.TemporaryDirectory() as scratch:
            # The hazard, reproduced exactly: standing instructions sitting
            # above the owi home, as this repo's own CLAUDE.md sits above
            # .owi-quick. A worker that inherits them stops being a worker.
            root = Path(scratch).resolve()
            for name in cwd_rule["forbidden_instruction_files"]:
                (root / name).write_text("# you are the router, not the worker\n")
            home = root / ".owi-quick"
            home.mkdir()
            (home / "runners.json").write_text('{"gpt-5-mini": "pwd"}')
            ran = owi_do.run_worker(home, "gpt-5-mini", "")
            where = Path(ran.output.strip()) if ran.output.strip() else None
            suite.check("the runner reports where it ran",
                        ran.usable and where is not None,
                        f"got {ran.output.strip()!r} ({ran.detail})")
            if where is not None:
                suite.check("workers do not execute from the owi home",
                            where.resolve() != home,
                            f"ran in the home directory: {where}")
                inherited = owi_do.instruction_files_above(where)
                suite.check("a worker inherits no standing instructions",
                            not inherited,
                            f"would obey: {inherited[:2]}")
                suite.check("the fixture reproduces the real hazard",
                            bool(owi_do.instruction_files_above(home)),
                            "the home under test has no instructions above "
                            "it, so this proves nothing")

    privacy_rules = frozen.get("privacy_expectations")
    if privacy_rules:
        print("\nconfidentiality (redaction and the memory)")
        with tempfile.TemporaryDirectory() as scratch:
            home = Path(scratch)
            owi_do.log_root_cause(
                home, "the secret battery recipe", "worker:x/text",
                "skill:text-editing", "worker", "leaked detail",
                privacy=privacy_rules["confidential_task_privacy"])
            raw = (home / "root-causes.jsonl").read_text()
            entry = json.loads(raw)
            suite.check("confidential failures are redacted in the memory",
                        entry["task"] == "[redacted]" and not entry["detail"]
                        and entry.get("confidential") is True
                        and "secret battery" not in raw, raw[:120])
            notes = owi_do.prevention_notes(home, "skill:text-editing")
            suite.check("confidential entries never become prevention notes",
                        notes == [], f"got {notes!r}")

    print("\nprevention filter")
    for fixture in frozen["prevention_fixtures"]:
        with tempfile.TemporaryDirectory() as scratch:
            home = Path(scratch)
            with (home / "root-causes.jsonl").open("w") as handle:
                for entry in fixture["entries"]:
                    handle.write(json.dumps(entry) + "\n")
            notes = owi_do.prevention_notes(home, fixture["skill"])
            suite.check("prevention filters causes and skill",
                        notes == fixture["expect_notes"],
                        f"got {notes!r}")

    if not no_cargo:
        print("\nprice import (exact micros)")
        prices = owi_do.owi(
            "prices", "--input",
            str(REPO / "examples/litellm-prices-sample.json"),
            "--options", str(REPO / "examples/price-import-options.json"),
            "--dry-run")
        offerings = {o["id"]: o for o in prices["offerings"]}
        expectations = frozen["price_expectations"]
        suite.check(
            f"at least {expectations['minimum_offerings']} offerings",
            len(offerings) >= expectations["minimum_offerings"],
            f"got {len(offerings)}")
        for offering_id, (want_in, want_out) in \
                expectations["exact_micros"].items():
            offering = offerings.get(offering_id)
            ok = (offering is not None
                  and offering["input_micros_per_million_tokens"] == want_in
                  and offering["output_micros_per_million_tokens"] == want_out)
            suite.check(offering_id, ok,
                        "missing" if offering is None else "micros drifted")

        print("\nroster (structure and staffing)")
        seed = json.loads(
            (REPO / "examples/manager-scenario-seed.json").read_text())
        roster = frozen["roster_expectations"]
        workers = {w["id"] for w in seed["worker_profiles"]}
        suite.check(f"at least {roster['minimum_workers']} workers",
                    len(workers) >= roster["minimum_workers"],
                    f"got {len(workers)}")
        suite.check(f"at least {roster['minimum_evidence']} evidence rows",
                    len(seed["evidence"]) >= roster["minimum_evidence"],
                    f"got {len(seed['evidence'])}")
        for worker_id in roster["required_workers"]:
            suite.check(worker_id, worker_id in workers, "missing from seed")
        evidence_workers = {e["worker_id"] for e in seed["evidence"]}
        suite.check("every evidence row names a rostered worker",
                    evidence_workers <= workers,
                    f"orphans: {sorted(evidence_workers - workers)[:3]}")
        if frozen.get("skill_coverage_expectations", {}).get(
                "every_skill_staffed"):
            staffed_skills = {s for w in seed["worker_profiles"]
                              for s in w["supported_skill_ids"]}
            missing = [s for s in owi_do.SKILLS if s not in staffed_skills]
            suite.check("every skill in the taxonomy has a seeded worker",
                        not missing, f"unstaffed: {missing}")
        offered = {w["offering_id"] for w in seed["worker_profiles"]}
        suite.check("every rostered offering has a price",
                    offered <= set(offerings),
                    f"unpriced: {sorted(offered - set(offerings))[:3]}")

        evidence_rules = frozen.get("evidence_import_expectations")
        if evidence_rules:
            print("\nevidence import (measured ability replacing assumed)")
            completed = subprocess.run(
                ["cargo", "run", "-q", "-p", "workforce-cli", "--", "evidence",
                 "--input", str(REPO / evidence_rules["payload"]),
                 "--options", str(REPO / evidence_rules["options"]),
                 "--dry-run"],
                cwd=REPO, capture_output=True, text=True)
            imported = (json.loads(completed.stdout)
                        if completed.returncode == 0 else {})
            suite.check("the import runs", bool(imported),
                        completed.stderr[-200:])
            if imported:
                suite.check(f"tier is {evidence_rules['expected_tier']}",
                            imported["evidence_tier"]
                            == evidence_rules["expected_tier"],
                            f"got {imported.get('evidence_tier')!r}")
                suite.check(f"{evidence_rules['expected_records']} records",
                            imported["imported_evidence"]
                            == evidence_rules["expected_records"],
                            f"got {imported.get('imported_evidence')}")
                by_release = {record["model_release_id"]: record
                              for record in imported["evidence"]}
                for release, want in \
                        evidence_rules["exact_normalized"].items():
                    got = by_release.get(release, {}).get("normalized_score")
                    suite.check(f"  {release} normalizes to {want}",
                                got is not None and abs(got - want) < 1e-9,
                                f"got {got!r}")
                if evidence_rules.get("worker_id_must_be_unset"):
                    claimed = [record["id"] for record in imported["evidence"]
                               if record.get("worker_id")]
                    suite.check("a release-level score claims no worker",
                                not claimed, f"claimed: {claimed[:2]}")

        available = frozen.get("availability_expectations")
        if available:
            print("\navailability (the headline must be something you can run)")
            for model, want in available["unlock_hints"].items():
                got = owi_do.unlock_hint(model)
                suite.check(f"unlocking {model} says: {want}", got == want,
                            f"got {got!r}")
            with tempfile.TemporaryDirectory() as scratch:
                home = Path(scratch)
                (home / "runners.json").write_text('{"haiku-4-5": "echo hi"}')
                eligible = [{"worker_id": "worker:gpt-5-nano/text"},
                            {"worker_id": "worker:haiku-4-5/text"}]
                here, elsewhere = owi_do.split_by_availability(home, eligible)
                suite.check("what you can run is separated",
                            [c["worker_id"] for c in here]
                            == ["worker:haiku-4-5/text"],
                            f"got {[c['worker_id'] for c in here]}")
                suite.check("what you cannot is kept, not discarded",
                            [c["worker_id"] for c in elsewhere]
                            == ["worker:gpt-5-nano/text"],
                            f"got {[c['worker_id'] for c in elsewhere]}")
            template = (REPO / "tools/owi_ask_template.html").read_text()
            suite.check("the page asks what you can run",
                        f'class="{available["page_control_selector"]}"'
                        in template)
            if available.get("math_block_stays_pure"):
                block = template.split("// >>> decision-math >>>", 1)[1] \
                                .split("// <<< decision-math <<<", 1)[0]
                suite.check("availability never leaks into the verified math",
                            "querySelectorAll" not in block
                            and "document." not in block)

        page_rules = frozen.get("page_math_expectations")
        if page_rules:
            print("\npage math (the browser's copy stays verifiable)")
            template = (REPO / "tools/owi_ask_template.html").read_text()
            start, end = page_rules["start_marker"], page_rules["end_marker"]
            marked = start in template and end in template
            suite.check("the decision-math block is still marked", marked,
                        "the page's copy of the rule can no longer be sliced "
                        "out and checked against the engine")
            if marked:
                block = template.split(start, 1)[1].split(end, 1)[0]
                impure = [name for name in page_rules["forbidden_in_block"]
                          if name in block]
                suite.check("the block is pure enough to run outside a "
                            "browser", not impure, f"reaches for: {impure}")
                missing = [name for name in page_rules["required_functions"]
                           if f"function {name}" not in block
                           and f"const {name}" not in block]
                suite.check("the block still defines the whole rule",
                            not missing, f"missing: {missing}")

        identity = frozen.get("bench_identity_expectations")
        if identity and identity.get("id_carries_run_identity"):
            print("\nbench identity (a worker can be measured more than once)")
            with tempfile.TemporaryDirectory() as scratch:
                area = Path(scratch)
                repo = area / "repo"
                repo.mkdir()
                (repo / "unit.py").write_text("def f():\n    return 1\n")
                corpus = {
                    "corpus_id": "corpus:selftest", "commit": "HEAD",
                    "skill_id": "skill:python-numerical-implementation",
                    "verify_command": ["python3", "-c", "raise SystemExit(0)"],
                    "tasks": [{
                        "task_id": "task:selftest:f", "qualified_name": "f",
                        "source_path": "unit.py", "instruction": "implement f",
                        "signature": "def f():", "docstring": "one",
                        "indent": "    ",
                        "patch": {"file": "unit.py", "start_line": 2,
                                  "end_line": 2, "stub": "    return 1"},
                    }],
                }
                corpus_path = area / "corpus.json"
                corpus_path.write_text(json.dumps(corpus))
                ids = []
                for stamp in ("2026-01-01T00:00:00Z", "2026-02-02T00:00:00Z"):
                    out = area / f"out-{stamp[:10]}"
                    subprocess.run(
                        [sys.executable, str(TOOLS / "run_bench.py"),
                         "--corpus", str(corpus_path), "--repo", str(repo),
                         "--worker-id", "worker:selftest/code",
                         "--adapter", "stub", "--observed-at", stamp,
                         "--outcome-dir", str(out),
                         "--report", str(area / f"r-{stamp[:10]}.json")],
                        capture_output=True, text=True)
                    written = sorted(out.glob("*.json"))
                    ids.append({json.loads(w.read_text())["event"]["id"]
                                for w in written})
                suite.check("two runs of the same worker produce distinct ids",
                            bool(ids[0]) and bool(ids[1])
                            and not (ids[0] & ids[1]),
                            f"overlap: {sorted(ids[0] & ids[1])[:1]}")
                suite.check("the id names the run it came from",
                            all("@2026-01-01T00:00:00Z" in i for i in ids[0]),
                            f"got {sorted(ids[0])[:1]}")

        extraction = frozen.get("bench_extraction_expectations")
        if extraction:
            print("\nbench extraction (a nested helper is not a restated "
                  "signature)")
            adapter_loader = importlib.machinery.SourceFileLoader(
                "bench_chat_adapter", str(TOOLS / "bench_chat_adapter.py"))
            adapter_spec = importlib.util.spec_from_loader(
                "bench_chat_adapter", adapter_loader)
            adapter = importlib.util.module_from_spec(adapter_spec)
            adapter_loader.exec_module(adapter)
            for fixture in extraction["fixtures"]:
                got = adapter.extract_body(fixture["reply"], "    ",
                                           fixture["qualified_name"])
                suite.check(fixture["name"], got == fixture["expect"],
                            f"got {got!r}")

        bench_rules = frozen.get("bench_blame_expectations")
        if bench_rules:
            print("\nbench blame (a broken adapter is not a failed model)")
            with tempfile.TemporaryDirectory() as scratch:
                # A one-task corpus over a trivial repo, run with an adapter
                # that cannot work. The model never wrote a line; nothing may
                # be recorded against it.
                area = Path(scratch)
                repo, out = area / "repo", area / "out"
                repo.mkdir()
                (repo / "unit.py").write_text("def f():\n    return 1\n")
                subprocess.run(["git", "init", "-q", str(repo)], check=True)
                corpus = {
                    "corpus_id": "corpus:selftest", "commit": "HEAD",
                    "skill_id": "skill:python-numerical-implementation",
                    "verify_command": ["python3", "-c", "raise SystemExit(0)"],
                    "tasks": [{
                        "task_id": "task:selftest:f",
                        "qualified_name": "f", "source_path": "unit.py",
                        "instruction": "implement f", "signature": "def f():",
                        "docstring": "one", "indent": "    ",
                        "patch": {"file": "unit.py", "start_line": 2,
                                  "end_line": 2},
                    }],
                }
                corpus_path = area / "corpus.json"
                corpus_path.write_text(json.dumps(corpus))
                completed = subprocess.run(
                    [sys.executable, str(TOOLS / "run_bench.py"),
                     "--corpus", str(corpus_path), "--repo", str(repo),
                     "--worker-id", "worker:selftest/code",
                     "--adapter", "command",
                     "--command", str(TOOLS / "no-such-adapter-exists"),
                     "--observed-at", "2026-01-01T00:00:00Z",
                     "--outcome-dir", str(out),
                     "--report", str(area / "report.json")],
                    capture_output=True, text=True)
                written = list(out.glob("*.json")) if out.exists() else []
                suite.check("a failed adapter records nothing against the "
                            "worker", not written,
                            f"wrote {len(written)} outcome record(s)")
                report = json.loads((area / "report.json").read_text())
                suite.check("the harness failure is reported, not hidden",
                            report.get("unscored_harness_failures") == 1
                            and report.get("scored") == 0,
                            f"report says {report.get('scored')} scored, "
                            f"{report.get('unscored_harness_failures')} "
                            f"unscored")
                suite.check("a run that measured nothing exits non-zero",
                            completed.returncode != 0,
                            "it exited 0, so CI would call it a pass")

        contract = frozen.get("runner_contract_expectations")
        if contract:
            print("\nrunner contract (one implementation, four failure modes)")
            import owi_runner
            for case in contract["failure_modes"]:
                result = owi_runner.run_worker(case["command"], "task text",
                                               timeout=case.get("timeout", 5))
                suite.check(f"{case['name']} is the environment's failure",
                            result.blame == owi_runner.ENVIRONMENT
                            and not result.usable and result.output == "",
                            f"blame={result.blame!r} output={result.output!r}")
            good = owi_runner.run_worker(contract["worker_command"], "task")
            suite.check("real output is the worker's own",
                        good.blame == owi_runner.WORKER and good.usable
                        and good.output.strip() != "",
                        f"blame={good.blame!r} output={good.output!r}")
            # The contract must have exactly one implementation. Any second
            # place that spawns a worker is how the last two bugs survived a
            # hand-fix in the first place.
            spawn_sites = []
            for name in contract["files_that_must_not_spawn"]:
                source = (REPO / name).read_text()
                if "subprocess.run(" in source or "subprocess.Popen(" in source:
                    spawn_sites.append(name)
            suite.check("only owi_runner spawns a worker", not spawn_sites,
                        f"also spawns: {spawn_sites}")

        blame = frozen.get("blame_expectations")
        if blame:
            print("\nblame rule (empty output is plumbing, not the worker)")
            with tempfile.TemporaryDirectory() as scratch:
                home = Path(scratch)
                owi_do.bootstrap(home)
                (home / "runners.json").write_text('{"gpt-5-mini": "true"}')
                verdict, _ = owi_do.attempt_run(
                    home, "worker:gpt-5-mini/text", "gpt-5-mini",
                    "skill:text-editing", "frozen-suite empty-output probe",
                    "", ["contains:anything"], None, None,
                    {"level": "full", "judge": False}, [])
                import sqlite3
                connection = sqlite3.connect(home / "local.sqlite")
                metadata = json.loads(connection.execute(
                    "SELECT metadata_json FROM outcome_events "
                    "ORDER BY rowid DESC LIMIT 1").fetchone()[0])
                connection.close()
                suite.check(
                    "empty output is recorded as environment, unchecked",
                    verdict == "rejected"
                    and metadata.get("root_cause") == blame["empty_output_cause"]
                    and "checklist" not in metadata,
                    f"got {verdict}, {metadata.get('root_cause')!r}")

        print("\nallocation (one real pick, pristine ledger)")
        with tempfile.TemporaryDirectory() as scratch:
            home = Path(scratch)
            index, local = home / "index.sqlite", home / "local.sqlite"
            owi_do.owi("prices", "--index", str(index),
                       "--input",
                       str(REPO / "examples/litellm-prices-sample.json"),
                       "--options",
                       str(REPO / "examples/price-import-options.json"))
            owi_do.owi("seed", "--index", str(index),
                       "--input",
                       str(REPO / "examples/manager-scenario-seed.json"))
            owi_do.owi("database", "init", "--index", str(index),
                       "--local", str(local))
            result = owi_do.pick(home, "frozen-suite allocation probe",
                                 "skill:text-editing", 2000, 800, 0)
            eligible = result["quote"]["eligible_candidates"]
            suite.check("someone qualifies for text-editing",
                        bool(eligible), "empty bench")
            if eligible:
                top = eligible[0]["worker_id"]
                suite.check("the pick is a text worker",
                            top.endswith("/text"), f"got {top}")
            if privacy_rules:
                confidential = owi_do.pick(
                    home, "frozen confidential probe", "skill:text-editing",
                    2000, 800, 0,
                    privacy_rules["confidential_task_privacy"])
                staffed = {c["worker_id"] for c in
                           confidential["quote"]["eligible_candidates"]}
                suite.check(
                    "a confidential task staffs only cleared workers",
                    staffed == {privacy_rules["cleared_worker"]},
                    f"got {sorted(staffed)}")

    clearance = frozen.get("verifier_clearance_expectations")
    if clearance:
        # The gate that stops a cloud model doing the work is worthless if
        # the crew that checks the work reads it anyway.
        print("\nverifier clearance (the gate covers the whole crew)")
        with tempfile.TemporaryDirectory() as scratch:
            home = Path(scratch)
            (home / "runners.json").write_text(json.dumps(
                {model: "true" for model in owi_do.JUDGE_ORDER}))
            cloud = clearance["cloud_model"]
            suite.check("a cloud model holds only metadata clearance",
                        owi_do.model_clearance(home, cloud)
                        == clearance["cloud_clearance"],
                        owi_do.model_clearance(home, cloud))
            suite.check("an ordinary task still gets the cheapest judge",
                        owi_do.judge_model_for(home, None,
                                               clearance["ordinary"])
                        == clearance["cheapest_ordinary_judge"])
            for role, resolve in (
                    ("judge", lambda: owi_do.judge_model_for(
                        home, None, clearance["confidential"])),
                    ("checklist writer", lambda: owi_do.writer_model_for(
                        home, clearance["confidential"])),
                    ("planner", lambda: owi_do.plan_parts(
                        home, "confidential text",
                        clearance["confidential"])[0])):
                suite.check(
                    f"no cloud {role} touches confidential work",
                    resolve() == clearance[
                        "confidential_judge_when_only_cloud_is_installed"],
                    f"got {resolve()!r}")
            report = owi_do.run_checklist(
                home, "task", "output", ["is it good?"],
                maker_model="local-x", privacy=clearance["confidential"])
            suite.check("an unjudgeable confidential item stays unchecked",
                        report["verdict"]
                        == clearance["unjudgeable_confidential_verdict"]
                        and report["judge"] is None, report["verdict"])
            suite.check("the note blames clearance, not a missing CLI",
                        "cleared for" in report["items"][0]["note"],
                        report["items"][0]["note"])
            mechanical = owi_do.run_checklist(
                home, "task", "alpha beta", ["contains:beta"],
                maker_model="local-x", privacy=clearance["confidential"])
            suite.check("mechanical checks still run under confidentiality",
                        mechanical["verdict"]
                        == clearance["mechanical_still_runs"],
                        mechanical["verdict"])

            # Filtering is only half of it: the ladders list cloud models, so
            # a hired local model has to reach them or confidential work can
            # never be judged at all.
            import owi_local
            for hired, target in (("local-a", "model-a"), ("local-b", "model-b")):
                owi_local.remember_local_model(home, hired, target)
            runners = json.loads((home / "runners.json").read_text())
            runners.update({"local-a": "true", "local-b": "true"})
            (home / "runners.json").write_text(json.dumps(runners))
            ladder = owi_do.helper_order(home, owi_do.JUDGE_ORDER)
            suite.check("hired models extend the ladder, at the end",
                        ladder[:len(owi_do.JUDGE_ORDER)] == owi_do.JUDGE_ORDER
                        and set(ladder[len(owi_do.JUDGE_ORDER):])
                        == {"local-a", "local-b"}, f"got {ladder}")
            suite.check("ordinary routing is unchanged by hiring",
                        owi_do.judge_model_for(home, None,
                                               clearance["ordinary"])
                        == clearance["cheapest_ordinary_judge"])
            suite.check("two local models can check each other's confidential "
                        "work",
                        owi_do.judge_model_for(home, "local-a",
                                               clearance["confidential"])
                        == "local-b"
                        and owi_do.judge_model_for(home, "local-b",
                                                   clearance["confidential"])
                        == "local-a")

    hire = frozen.get("hire_local_expectations")
    if hire:
        print("\nhiring a local model (declared, never invented)")
        import owi_local
        declared = owi_local.declaration(
            model=hire["model"], context_window=hire["context_window_tokens"],
            roles=hire["roles"], worker_prefix=f"local-{hire['model']}",
            developer="frozen", recorded_at="2026-08-26T00:00:00Z",
            snapshot_id="snapshot:frozen-hire",
            at_epoch_ms=owi_do.AT_EPOCH_MS)
        digests = [w["configuration_sha256"]
                   for w in declared["worker_profiles"]]
        suite.check("each hired role gets its own configuration digest",
                    len(set(digests)) == len(digests) == len(hire["roles"]),
                    f"got {digests}")
        suite.check("every hired worker is cleared for confidential content",
                    all(w["privacy_clearance"] == hire["clearance"]
                        for w in declared["worker_profiles"]))
        offering = declared["provider_offerings"][0]
        suite.check("a local model is priced at zero, not guessed",
                    offering["input_micros_per_million_tokens"]
                    == hire["input_micros_per_million_tokens"]
                    and offering["output_micros_per_million_tokens"]
                    == hire["output_micros_per_million_tokens"])
        suite.check("the window is the model card's, carried verbatim",
                    offering["context_window_tokens"]
                    == hire["context_window_tokens"])
        suite.check("the source admits it is a declaration",
                    offering["source_url"].startswith(
                        hire["source_url_prefix"]), offering["source_url"])
        suite.check("ability is assumed at the weakest tier",
                    all(e["evidence_tier"] == hire["evidence_tier"]
                        for e in declared["evidence"]))
        with tempfile.TemporaryDirectory() as scratch:
            home = Path(scratch)
            suite.check("with no pointer, decisions quote the seeded snapshot",
                        owi_local.current_snapshot(home)
                        == hire["default_snapshot"])
            (home / owi_local.POINTER).write_text("{ not json")
            suite.check("a corrupt pointer falls back rather than guessing",
                        owi_local.current_snapshot(home)
                        == hire["default_snapshot"])

    missing = frozen.get("missing_input_expectations")
    if missing:
        # A mechanical checklist cannot tell an answer from a request for the
        # question. This is the guard that stops the ledger learning from work
        # that was never done.
        print("\nmissing input (an ask is not an answer)")
        for reply in missing["caught"]:
            suite.check(f"caught: {reply[:44]}...",
                        owi_do.asks_for_missing_input(reply) is not None)
        for reply in missing["passed"]:
            got = owi_do.asks_for_missing_input(reply)
            suite.check(f"real work survives: {reply[:34]}...",
                        got is None, f"falsely flagged on {got!r}")
        long_enough = " ".join(["word"] * (missing["max_words"] + 1))
        suite.check("a long reply is never flagged, whatever it says",
                    owi_do.asks_for_missing_input(
                        "I don't see the document. " + long_enough) is None)
        for task in missing["deictic_with_empty_stdin"]:
            suite.check(f"warned before spending: {task[:38]}...",
                        owi_do.points_at_missing_material(task, "") is not None)
            suite.check(f"not warned once attached: {task[:36]}...",
                        owi_do.points_at_missing_material(
                            task, "the material") is None)
        for task in missing["deictic_complete"]:
            suite.check(f"a complete task is not warned: {task[:32]}...",
                        owi_do.points_at_missing_material(task, "") is None)

    total = suite.passed + len(suite.failed)
    print(f"\n{frozen['version']}: {suite.passed}/{total} passed")
    for name in suite.failed:
        print(f"  LOST: {name}", file=sys.stderr)
    return 1 if suite.failed else 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--no-cargo", action="store_true",
                        help="skip the sections that build the workspace")
    return run(parser.parse_args().no_cargo)


if __name__ == "__main__":
    raise SystemExit(main())
