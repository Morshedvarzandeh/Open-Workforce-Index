#!/usr/bin/env python3
"""owi-selftest — the frozen high-level suite.

    tools/owi-selftest                      # full suite (needs cargo)
    tools/owi-selftest --no-cargo           # engine-only, no build step

As the loop gets more automated, this is the brake: the expectations in
examples/frozen-checks-v*.json are pinned versions of behaviour that already
worked — prices that imported exactly, the roster that staffed, the check
engine's verdicts, the planner's validation, the prevention filter. Any change
that would lose them fails here first, not in a live run.

The checklist file is evolutionary: lived failures get frozen into it as new
fixtures (with provenance), and the version bumps. This runner never calls a
model and never touches the network — everything it checks is deterministic.
"""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import sys
import tempfile
from pathlib import Path

TOOLS = Path(__file__).resolve().parent
REPO = TOOLS.parent

_loader = importlib.machinery.SourceFileLoader("owi_do", str(TOOLS / "owi-do"))
_spec = importlib.util.spec_from_loader("owi_do", _loader)
owi_do = importlib.util.module_from_spec(_spec)
_loader.exec_module(owi_do)


class Suite:
    def __init__(self) -> None:
        self.passed = 0
        self.failed: list[str] = []

    def check(self, name: str, ok: bool, note: str = "") -> None:
        if ok:
            self.passed += 1
        else:
            self.failed.append(f"{name}{' — ' + note if note else ''}")
        print(f"  [{'ok' if ok else 'FAIL'}] {name}")


def run(no_cargo: bool) -> int:
    frozen = json.loads(
        (REPO / "examples/frozen-checks-v1.json").read_text())
    suite = Suite()
    print(f"frozen suite: {frozen['version']} (frozen {frozen['frozen_at']})")

    print("\ncheck engine")
    for fixture in frozen["check_engine_fixtures"]:
        kind, verdict, _ = owi_do.check_item(fixture["item"], fixture["output"])
        want = fixture["expect"]
        suite.check(
            f"{fixture['kind']}: {fixture['item'][:44]!r}",
            verdict is want if want is None else verdict == want,
            f"got {verdict!r}, want {want!r}")
        suite.check(f"  labelled {fixture['kind']}", kind == fixture["kind"],
                    f"got {kind!r}")

    print("\nplanner validation")
    for position, fixture in enumerate(frozen["planner_fixtures"], start=1):
        cleaned = owi_do.clean_parts(fixture["raw"])
        want = fixture["expect_parts"]
        got = None if cleaned is None else len(cleaned)
        suite.check(f"planner fixture {position}", got == want,
                    f"got {got!r}, want {want!r}")

    gate = frozen.get("serve_gate_expectations")
    if gate:
        print("\nserve access gate")
        import threading
        import urllib.error
        import urllib.request
        from http.server import ThreadingHTTPServer
        serve_loader = importlib.machinery.SourceFileLoader(
            "owi_serve", str(TOOLS / "owi-serve"))
        serve_spec = importlib.util.spec_from_loader("owi_serve", serve_loader)
        owi_serve = importlib.util.module_from_spec(serve_spec)
        serve_loader.exec_module(owi_serve)

        def status(url: str, headers: dict | None = None) -> int:
            request = urllib.request.Request(url, headers=headers or {})
            try:
                with urllib.request.urlopen(request, timeout=5) as response:
                    return response.status
            except urllib.error.HTTPError as error:
                return error.code

        owi_serve.Handler.token = "frozen-suite-token"
        owi_serve.Handler.data = {}
        server = ThreadingHTTPServer(("127.0.0.1", 0), owi_serve.Handler)
        threading.Thread(target=server.serve_forever, daemon=True).start()
        base = f"http://127.0.0.1:{server.server_address[1]}"
        want = gate["unauthorized_status"]
        suite.check("a request without the token is turned away",
                    status(f"{base}/api/data") == want)
        suite.check("the token in a header admits",
                    status(f"{base}/api/data",
                           {"X-OWI-Token": "frozen-suite-token"}) == 200)
        suite.check("the token as a query admits",
                    status(f"{base}/api/data?token=frozen-suite-token") == 200)
        owi_serve.Handler.token = None
        suite.check("localhost mode stays gate-free",
                    status(f"{base}/api/data") == 200)
        server.shutdown()

    qc = frozen.get("qc_expectations")
    if qc:
        print("\nquality control (lean inspection contract)")
        suite.check(f"clearance is {qc['clearance']} clean accepts",
                    owi_do.QC["clearance"] == qc["clearance"],
                    f"got {owi_do.QC['clearance']}")
        suite.check(f"sampling is 1-in-{qc['sample_every']} once cleared",
                    owi_do.QC["sample_every"] == qc["sample_every"],
                    f"got {owi_do.QC['sample_every']}")
        for position, fixture in enumerate(
                frozen.get("sampling_fixtures", []), start=1):
            with tempfile.TemporaryDirectory() as scratch:
                report = owi_do.run_checklist(
                    Path(scratch), "frozen-suite probe", fixture["output"],
                    fixture["items"], maker_model="none",
                    judge_enabled=False)
            suite.check(f"sampling fixture {position}",
                        report["verdict"] == fixture["expect_verdict"],
                        f"got {report['verdict']!r}")
        with tempfile.TemporaryDirectory() as scratch:
            level = owi_do.inspection_for(Path(scratch), "worker:x/text",
                                          "skill:text-editing")
        suite.check("a worker with no history starts at full inspection",
                    level["level"] == "full" and level["judge"],
                    f"got {level!r}")

    roles = frozen.get("role_order_expectations")
    if roles:
        print("\nrole ladders (spec from the top, judging from the bottom)")
        suite.check("checklist writers are smartest-first",
                    owi_do.WRITER_ORDER[:2] == roles["writer_head"],
                    f"got {owi_do.WRITER_ORDER[:2]}")
        suite.check("judges are cheapest-first",
                    owi_do.JUDGE_ORDER[:2] == roles["judge_head"],
                    f"got {owi_do.JUDGE_ORDER[:2]}")

    print("\nauto-checklist cleaning")
    for position, fixture in enumerate(
            frozen.get("auto_checklist_fixtures", []), start=1):
        got = owi_do.clean_checklist(fixture["raw"])
        suite.check(f"auto-checklist fixture {position}",
                    got == fixture["expect"], f"got {got!r}")

    print("\nescalation (iterate-until-verified)")
    for position, fixture in enumerate(
            frozen.get("escalation_fixtures", []), start=1):
        eligible = [{"worker_id": w} for w in fixture["eligible"]]
        runnable_models = {w.split(":")[1].split("/")[0]
                           for w in fixture["runnable"]}
        prefer = ({"worker_id": fixture["prefer"]}
                  if fixture["prefer"] else None)
        got = owi_do.next_attempt_candidate(
            eligible, fixture["tried"],
            lambda model: model in runnable_models, prefer)
        got_id = got["worker_id"] if got else None
        suite.check(f"escalation fixture {position}",
                    got_id == fixture["expect"],
                    f"got {got_id!r}, want {fixture['expect']!r}")

    cwd_rule = frozen.get("runner_cwd_expectations")
    if cwd_rule:
        print("\nrunner working directory (neutral home, never the caller's)")
        with tempfile.TemporaryDirectory() as scratch:
            home = Path(scratch).resolve()
            (home / "runners.json").write_text('{"gpt-5-mini": "pwd"}')
            stdout, _, code = owi_do.run_command(home, "gpt-5-mini", "")
            suite.check("workers execute from the home directory",
                        code == 0 and Path(stdout.strip()) == home,
                        f"got {stdout.strip()!r}")

    privacy_rules = frozen.get("privacy_expectations")
    if privacy_rules:
        print("\nconfidentiality (redaction and the memory)")
        with tempfile.TemporaryDirectory() as scratch:
            home = Path(scratch)
            owi_do.log_root_cause(
                home, "the secret battery recipe", "worker:x/text",
                "skill:text-editing", "worker", "leaked detail",
                privacy=privacy_rules["confidential_task_privacy"])
            raw = (home / "root-causes.jsonl").read_text()
            entry = json.loads(raw)
            suite.check("confidential failures are redacted in the memory",
                        entry["task"] == "[redacted]" and not entry["detail"]
                        and entry.get("confidential") is True
                        and "secret battery" not in raw, raw[:120])
            notes = owi_do.prevention_notes(home, "skill:text-editing")
            suite.check("confidential entries never become prevention notes",
                        notes == [], f"got {notes!r}")

    print("\nprevention filter")
    for fixture in frozen["prevention_fixtures"]:
        with tempfile.TemporaryDirectory() as scratch:
            home = Path(scratch)
            with (home / "root-causes.jsonl").open("w") as handle:
                for entry in fixture["entries"]:
                    handle.write(json.dumps(entry) + "\n")
            notes = owi_do.prevention_notes(home, fixture["skill"])
            suite.check("prevention filters causes and skill",
                        notes == fixture["expect_notes"],
                        f"got {notes!r}")

    if not no_cargo:
        print("\nprice import (exact micros)")
        prices = owi_do.owi(
            "prices", "--input",
            str(REPO / "examples/litellm-prices-sample.json"),
            "--options", str(REPO / "examples/price-import-options.json"),
            "--dry-run")
        offerings = {o["id"]: o for o in prices["offerings"]}
        expectations = frozen["price_expectations"]
        suite.check(
            f"at least {expectations['minimum_offerings']} offerings",
            len(offerings) >= expectations["minimum_offerings"],
            f"got {len(offerings)}")
        for offering_id, (want_in, want_out) in \
                expectations["exact_micros"].items():
            offering = offerings.get(offering_id)
            ok = (offering is not None
                  and offering["input_micros_per_million_tokens"] == want_in
                  and offering["output_micros_per_million_tokens"] == want_out)
            suite.check(offering_id, ok,
                        "missing" if offering is None else "micros drifted")

        print("\nroster (structure and staffing)")
        seed = json.loads(
            (REPO / "examples/manager-scenario-seed.json").read_text())
        roster = frozen["roster_expectations"]
        workers = {w["id"] for w in seed["worker_profiles"]}
        suite.check(f"at least {roster['minimum_workers']} workers",
                    len(workers) >= roster["minimum_workers"],
                    f"got {len(workers)}")
        suite.check(f"at least {roster['minimum_evidence']} evidence rows",
                    len(seed["evidence"]) >= roster["minimum_evidence"],
                    f"got {len(seed['evidence'])}")
        for worker_id in roster["required_workers"]:
            suite.check(worker_id, worker_id in workers, "missing from seed")
        evidence_workers = {e["worker_id"] for e in seed["evidence"]}
        suite.check("every evidence row names a rostered worker",
                    evidence_workers <= workers,
                    f"orphans: {sorted(evidence_workers - workers)[:3]}")
        if frozen.get("skill_coverage_expectations", {}).get(
                "every_skill_staffed"):
            staffed_skills = {s for w in seed["worker_profiles"]
                              for s in w["supported_skill_ids"]}
            missing = [s for s in owi_do.SKILLS if s not in staffed_skills]
            suite.check("every skill in the taxonomy has a seeded worker",
                        not missing, f"unstaffed: {missing}")
        offered = {w["offering_id"] for w in seed["worker_profiles"]}
        suite.check("every rostered offering has a price",
                    offered <= set(offerings),
                    f"unpriced: {sorted(offered - set(offerings))[:3]}")

        blame = frozen.get("blame_expectations")
        if blame:
            print("\nblame rule (empty output is plumbing, not the worker)")
            with tempfile.TemporaryDirectory() as scratch:
                home = Path(scratch)
                owi_do.bootstrap(home)
                (home / "runners.json").write_text('{"gpt-5-mini": "true"}')
                verdict, _ = owi_do.attempt_run(
                    home, "worker:gpt-5-mini/text", "gpt-5-mini",
                    "skill:text-editing", "frozen-suite empty-output probe",
                    "", ["contains:anything"], None, None,
                    {"level": "full", "judge": False}, [])
                import sqlite3
                connection = sqlite3.connect(home / "local.sqlite")
                metadata = json.loads(connection.execute(
                    "SELECT metadata_json FROM outcome_events "
                    "ORDER BY rowid DESC LIMIT 1").fetchone()[0])
                connection.close()
                suite.check(
                    "empty output is recorded as environment, unchecked",
                    verdict == "rejected"
                    and metadata.get("root_cause") == blame["empty_output_cause"]
                    and "checklist" not in metadata,
                    f"got {verdict}, {metadata.get('root_cause')!r}")

        print("\nallocation (one real pick, pristine ledger)")
        with tempfile.TemporaryDirectory() as scratch:
            home = Path(scratch)
            index, local = home / "index.sqlite", home / "local.sqlite"
            owi_do.owi("prices", "--index", str(index),
                       "--input",
                       str(REPO / "examples/litellm-prices-sample.json"),
                       "--options",
                       str(REPO / "examples/price-import-options.json"))
            owi_do.owi("seed", "--index", str(index),
                       "--input",
                       str(REPO / "examples/manager-scenario-seed.json"))
            owi_do.owi("database", "init", "--index", str(index),
                       "--local", str(local))
            result = owi_do.pick(home, "frozen-suite allocation probe",
                                 "skill:text-editing", 2000, 800, 0)
            eligible = result["quote"]["eligible_candidates"]
            suite.check("someone qualifies for text-editing",
                        bool(eligible), "empty bench")
            if eligible:
                top = eligible[0]["worker_id"]
                suite.check("the pick is a text worker",
                            top.endswith("/text"), f"got {top}")
            if privacy_rules:
                confidential = owi_do.pick(
                    home, "frozen confidential probe", "skill:text-editing",
                    2000, 800, 0,
                    privacy_rules["confidential_task_privacy"])
                staffed = {c["worker_id"] for c in
                           confidential["quote"]["eligible_candidates"]}
                suite.check(
                    "a confidential task staffs only cleared workers",
                    staffed == {privacy_rules["cleared_worker"]},
                    f"got {sorted(staffed)}")

    total = suite.passed + len(suite.failed)
    print(f"\n{frozen['version']}: {suite.passed}/{total} passed")
    for name in suite.failed:
        print(f"  LOST: {name}", file=sys.stderr)
    return 1 if suite.failed else 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--no-cargo", action="store_true",
                        help="skip the sections that build the workspace")
    return run(parser.parse_args().no_cargo)


if __name__ == "__main__":
    raise SystemExit(main())
