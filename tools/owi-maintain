#!/usr/bin/env python3
"""Manage local billing declarations and self-updating working instructions.

Examples:
  tools/owi-maintain status
  tools/owi-maintain usage
  tools/owi-maintain configure --input my-runtime-settings.json
  tools/owi-maintain pause
  tools/owi-maintain resume
  tools/owi-maintain rollback --model haiku-4-5

Automatic instruction updates run after deterministic result checks. This
command makes no provider calls and does not update model weights or software.
"""
import argparse
import json
from pathlib import Path
import owi_runtime as runtime


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("action", choices=("status", "usage", "configure", "pause", "resume", "rollback"))
    parser.add_argument("--home", type=Path, default=Path(__file__).resolve().parent.parent / ".owi-quick")
    parser.add_argument("--input", type=Path)
    parser.add_argument("--model")
    args = parser.parse_args()
    try:
        if args.action == "configure":
            if not args.input:
                parser.error("configure requires --input")
            runtime.save_settings(args.home, json.loads(args.input.read_text()))
        elif args.action in ("pause", "resume"):
            value = runtime.settings(args.home)
            value["learning"] = args.action == "resume"
            runtime.save_settings(args.home, value)
        elif args.action == "rollback":
            if not args.model:
                parser.error("rollback requires --model")
            runtime.rollback(args.home, args.model)
        print(json.dumps(runtime.recent_usage(args.home) if args.action == "usage"
                         else runtime.snapshot(args.home), indent=2))
    except (ValueError, OSError) as error:
        parser.exit(1, str(error) + "\n")


if __name__ == "__main__":
    main()
