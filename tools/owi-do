def choose(home: Path, task: str, skill: str, tokens_in: int, tokens_out: int,
           rate: int, privacy: str = "private_metadata") -> tuple[dict, dict, list]:
    result = pick(home, task, skill, tokens_in, tokens_out, rate, privacy)
    quote = result["quote"]
    return result, quote, quote["eligible_candidates"]


def quality_option(calibration, eligible: list):
    """The eligible worker with the highest posterior mean — the other corner
    of the cost/quality/time triangle, surfaced so the trade is the owner's
    to make, not buried under the cost ranking."""
    means = {}
    for cal in calibration or []:
        if cal.get("skills"):
            post = cal["skills"][0]["posterior"]
            means[cal["worker_id"]] = post["alpha"] / (post["alpha"]
                                                       + post["beta"])
    ranked = sorted((c for c in eligible if c["worker_id"] in means),
                    key=lambda c: (-means[c["worker_id"]],
                                   c["cost"]["expected_accepted_cost_micros"]))
    return (ranked[0] if ranked else None), means


def prefer_quality(result: dict, eligible: list) -> list:
    best, _ = quality_option(result.get("calibration"), eligible)
    if best and best["worker_id"] != eligible[0]["worker_id"]:
        print("quality mode: picking the strongest qualified worker")
        return [best] + [c for c in eligible
                         if c["worker_id"] != best["worker_id"]]
    return eligible


def print_pick(quote: dict, eligible: list, calibration=None) -> None:
    top = eligible[0]
    print(f"\n→ {top['worker_id'].replace('worker:', '')}   "
          f"${top['cost']['expected_accepted_cost_micros'] / MICROS:.4f} "
          f"per accepted result")
    for alt in eligible[1:3]:
        extra = (alt["cost"]["expected_accepted_cost_micros"]
                 - top["cost"]["expected_accepted_cost_micros"]) / MICROS
        print(f"  next: {alt['worker_id'].replace('worker:', ''):22} "
              f"+${extra:.4f}")
    best, means = quality_option(calibration, eligible)
    if best is not None and best["worker_id"] != top["worker_id"]:
        extra = (best["cost"]["expected_accepted_cost_micros"]
                 - top["cost"]["expected_accepted_cost_micros"]) / MICROS
        print(f"  quality option: {best['worker_id'].replace('worker:', ''):13} "
              f"+${extra:.4f} · est {means[best['worker_id']]:.2f} vs "
              f"{means.get(top['worker_id'], 0.0):.2f}  (--quality to use)")
    print(f"  checked {len(eligible) + len(quote['rejected_candidates'])}, "
          f"turned away {len(quote['rejected_candidates'])} · decision recorded")


def next_attempt_candidate(eligible: list, tried: list, is_runnable,
                           prefer=None):
    """Who takes the next attempt. First attempt: the cheapest runnable
    worker. Retries: the preferred candidate (the quality option) when it is
    runnable and untried — a failure is evidence the job was harder than its
    price — otherwise the next untried runnable worker in bench order."""
    def usable(candidate):
        model = candidate["worker_id"].split(":")[1].split("/")[0]
        return candidate["worker_id"] not in tried and is_runnable(model)
    if prefer is not None and usable(prefer):
        return prefer
    return next((c for c in eligible if usable(c)), None)


def iterate(home: Path, eligible: list, calibration, skill: str, task: str,
            stdin_text: str, checklist: list[str], arguments,
            explicit: bool) -> tuple[str, str | None]:
    privacy = PRIVACY[getattr(arguments, "privacy", "metadata")]
    """Redo until it is right, within bounds: attempt, verify, and on a
    rejection feed the exact failed items back as corrections and escalate.
    Every attempt is recorded — iteration never erases a failure, it answers
    one. Returns (final verdict, worker that produced it)."""
    runnable = lambda model: resolve_runner(home, model) is not None  # noqa: E731
    tried: list = []
    corrections: list[str] = []
    quality, _ = quality_option(calibration, eligible)
    for attempt in range(1, max(1, arguments.attempts) + 1):
        candidate = next_attempt_candidate(
            eligible, tried, runnable, prefer=quality if attempt > 1 else None)
        if candidate is None:
            if not tried:
                print(f"\nno runner for any eligible worker. Fill in "
                      f"{home}/runners.json")
                return "no runner", None
            print("  nobody left to escalate to")
            break
        worker = candidate["worker_id"]
        model = worker.split(":")[1].split("/")[0]
        if attempt == 1 and worker != eligible[0]["worker_id"]:
            skipped = eligible[0]["worker_id"].split(":")[1].split("/")[0]
            print(f"\n{skipped} has no runner here — running with "
                  f"{worker.replace('worker:', '')} (cheapest runnable)")
        if attempt > 1:
            print(f"\niteration {attempt}/{arguments.attempts}: escalating to "
                  f"{worker.replace('worker:', '')}")
        if explicit:
            inspection = {"level": "full", "judge": True,
                          "why": "explicit checklist — always fully verified"}
        else:
            inspection = inspection_for(home, worker, skill)
        print(f"inspection: {inspection['level']} — {inspection['why']}")
        verdict, failed = attempt_run(home, worker, model, skill, task,
                                      stdin_text, checklist,
                                      arguments.accepted, arguments.cause,
                                      inspection, corrections, privacy=privacy)
        tried.append(worker)
        if verdict == "accepted":
            if attempt > 1:
                print(f"verified after {attempt} iterations — "
                      "the earlier failures stay in the ledger")
            return "accepted", worker
        if verdict == "unrecorded":
            return "unrecorded", worker
        corrections = [failed] if failed else []
    print(f"still rejected after {len(tried)} attempt(s) — every failure is "
          "in the ledger and the prevention memory")
    return "rejected", tried[-1] if tried else None


def attempt_run(home: Path, worker: str, model: str, skill: str,
                task: str, stdin_text: str, checklist: list[str],
                accepted_flag: str | None, cause_flag: str | None,
                inspection: dict, corrections: list[str],
                privacy: str = "private_metadata") -> tuple[str, str]:
    """One attempt: run, verify against the checklist, record. Returns
    (verdict, failed-detail) — the detail feeds the next iteration's
    corrections when the checklist rejected the work."""
    notes = prevention_notes(home, skill)
    if notes:
        print(f"prevention: carrying {len(notes)} note(s) from past "
              "rejections of this skill")
    payload = build_payload(task, stdin_text, checklist, notes, corrections)
    print(f"\nrunning via: {resolve_runner(home, model)}\n" + "-" * 60)
    try:
        stdout, stderr, code = run_command(home, model, payload)
    except subprocess.TimeoutExpired:
        print("-" * 60)
        print("timed out after 600s")
        record_outcome(home, worker, skill, False, "environment", task=task,
                       detail="runner timed out after 600s", privacy=privacy)
        return "rejected", ""
    print(stdout.strip() or "(no output)")
    print("-" * 60)
    if code != 0:
        sys.stderr.write(stderr[-1500:])
        print(f"runner exited {code} — the plumbing failed, not the model")
        record_outcome(home, worker, skill, False, "environment", task=task,
                       detail=f"runner exit {code}: {stderr[:300]}", privacy=privacy)
        return "rejected", ""
    if not stdout.strip():
        # A model never replies with literally nothing. Empty stdout is
        # plumbing — CLI collision, auth, a crash that exited zero — and a
        # checklist run against "" would wrongly convict the worker.
        # Learned from two misattributed rejections during concurrent runs.
        print("runner produced no output — the plumbing failed, not the model")
        record_outcome(home, worker, skill, False, "environment", task=task,
                       detail="runner produced no output", privacy=privacy)
        return "rejected", ""

    if accepted_flag is not None:
        accepted = accepted_flag == "y"
        record_outcome(home, worker, skill, accepted,
                       cause_flag if not accepted else None, task=task,
                       privacy=privacy)
        return ("accepted" if accepted else "rejected"), ""

    if checklist:
        report = run_checklist(home, task, stdout, checklist, maker_model=model,
                               judge_enabled=inspection["judge"])
        marks = {True: "✓", False: "✗", None: "?"}
        for entry in report["items"]:
            print(f"  [{marks[entry['pass']]}] {entry['item']} — {entry['note']}")
        judged = f" · judge: {report['judge']}" if report["judge"] else ""
        checked = sum(1 for entry in report["items"]
                      if entry["pass"] is not None)
        if report["verdict"] == "accepted":
            print(f"checklist: {checked}/{len(checklist)} "
                  f"checked, all passed{judged} → accepted")
            record_outcome(home, worker, skill, True, task=task,
                           checklist=report["items"],
                           inspection=inspection["level"], privacy=privacy)
            return "accepted", ""
        if report["verdict"] == "rejected":
            detail = "; ".join(f"failed: {entry['item']} ({entry['note']})"
                               for entry in report["items"]
                               if entry["pass"] is False)
            print(f"checklist: failed{judged} → rejected, root cause: worker")
            record_outcome(home, worker, skill, False, "worker", task=task,
                           detail=detail, checklist=report["items"],
                           inspection=inspection["level"], privacy=privacy)
            return "rejected", detail
        print(f"checklist: could not verify every item{judged} — your call")

    try:
        answer = input("accepted? [y/n] ").strip().lower()
        if answer == "y":
            record_outcome(home, worker, skill, True, task=task,
                           privacy=privacy)
            return "accepted", ""
        if answer == "n":
            record_outcome(home, worker, skill, False,
                           cause_flag or ask_cause(), task=task,
                           privacy=privacy)
            return "rejected", ""
        print("not recorded (answer y or n next time)", file=sys.stderr)
    except EOFError:
        print("not recorded (no answer; use --accepted y|n in scripts)",
              file=sys.stderr)
    return "unrecorded", ""


CAUSES = {"m": "worker", "t": "task_spec", "s": "environment", "h": "harness"}


def ask_cause() -> str:
    try:
        answer = input(
            "why? [m]odel's fault / [t]ask unclear / my [s]etup / "
            "[h]arness (enter = model) ").strip().lower()
    except EOFError:
        return "worker"
    return CAUSES.get(answer[:1], "worker") if answer else "worker"


def run_split(arguments, stdin_text: str) -> int:
    home = arguments.home
    full = arguments.task + ("\n\n" + stdin_text if stdin_text else "")
    planner, parts = plan_parts(home, full)
    if planner is None:
        print("no runnable planner model — fill in "
              f"{home}/runners.json or drop --split")
        return 1
    if parts is None:
        print(f"planner ({planner}) produced no usable split — "
              "running as one task")
        parts = [{"summary": arguments.task,
                  "skill": arguments.skill or classify(arguments.task),
                  "checklist": arguments.check or []}]
    else:
        kinds = len({part["skill"] for part in parts})
        print(f"planner ({planner}): {len(parts)} part(s), "
              f"{kinds} kind(s) of work")

    outcomes = []
    for position, part in enumerate(parts, start=1):
        print(f"\n━━ part {position}/{len(parts)} · "
              f"{part['skill'].replace('skill:', '')}")
        print(f"   {part['summary']}")
        for item in part["checklist"]:
            print(f"   check: {item}")
        tokens_in = 1500 + len(part["summary"]) // 4
        result, quote, eligible = choose(home, part["summary"], part["skill"],
                                         tokens_in, 800, arguments.rate,
                                         PRIVACY[getattr(arguments, "privacy",
                                                         "metadata")])
        if not eligible:
            reasons = sorted({reason["code"]
                              for candidate in quote["rejected_candidates"]
                              for reason in candidate["reasons"]})
            print(f"   nobody qualified: {', '.join(reasons)}")
            outcomes.append((part, None, "unstaffed"))
            continue
        if arguments.quality:
            eligible = prefer_quality(result, eligible)
        print_pick(quote, eligible, result.get("calibration"))
        if not arguments.run:
            outcomes.append((part, eligible[0], "planned"))
            continue
        first = next_attempt_candidate(
            eligible, [], lambda m: resolve_runner(home, m) is not None)
        if first is None:
            print(f"   no runner for any eligible worker — fill in "
                  f"{home}/runners.json")
            outcomes.append((part, eligible[0], "no runner"))
            continue
        if not part["checklist"]:
            tier = inspection_for(home, first["worker_id"],
                                  part["skill"])["level"]
            writer, part["checklist"] = auto_checklist(
                home, part["summary"], tier=tier)
            for item in part["checklist"]:
                print(f"   check (auto, by {writer}): {item}")
        verdict, final_worker = iterate(home, eligible,
                                        result.get("calibration"),
                                        part["skill"], part["summary"], "",
                                        part["checklist"], arguments, False)
        # The summary names who actually produced the final verdict.
        actual = next((candidate for candidate in eligible
                       if candidate["worker_id"] == final_worker),
                      eligible[0])
        outcomes.append((part, actual, verdict))

    print("\n" + "━" * 64)
    for part, candidate, verdict in outcomes:
        who = (candidate["worker_id"].replace("worker:", "")
               if candidate else "—")
        price = (f"${candidate['cost']['expected_accepted_cost_micros'] / MICROS:.4f}"
                 if candidate else "—")
        print(f"  {verdict:10} {who:22} {price:>9}  {part['summary'][:44]}")
    total = sum(candidate["cost"]["expected_accepted_cost_micros"]
                for _, candidate, _ in outcomes if candidate)
    print(f"  expected cost, all parts: ${total / MICROS:.4f}")
    good = all(verdict in ("accepted", "planned", "unrecorded")
               for _, _, verdict in outcomes)
    return 0 if good else 1


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("task", help="what you want done, in plain words")
    parser.add_argument("--skill", choices=sorted(SKILLS),
                        help="override the keyword guess")
    parser.add_argument("--rate", type=int, default=0,
                        help="advanced: also charge your own time at this "
                             "many dollars per hour (default 0 = cash only)")
    parser.add_argument("--quality", action="store_true",
                        help="pick the strongest qualified worker instead of "
                             "the cheapest (the quality option is always "
                             "printed either way)")
    parser.add_argument("--privacy",
                        choices=["public", "metadata", "confidential", "secret"],
                        default="metadata",
                        help="confidentiality of this task. Above 'metadata', "
                             "only workers whose clearance covers it are "
                             "considered (a gate, not a preference), and the "
                             "prevention memory keeps only redacted statistics")
    parser.add_argument("--attempts", type=int, default=2,
                        help="iterate until the checklist passes: on a "
                             "rejection the exact failures are fed back as "
                             "corrections and the work escalates to the "
                             "quality option, up to this many attempts "
                             "(default 2, matching the priced max_attempts)")
    parser.add_argument("--run", action="store_true",
                        help="execute via your configured runner and record the outcome")
    parser.add_argument("--check", action="append", metavar="ITEM",
                        help="checklist item the result must pass (repeatable). "
                             "Mechanical: contains:TEXT, regex:PATTERN, json, "
                             "python, min-words:N. Anything else is judged by "
                             "a different model than the maker. Omitted? The "
                             "smartest runnable model writes it for you. "
                             "--check none = no checklist, manual y/n verdict")
    parser.add_argument("--split", action="store_true",
                        help="let the smartest runnable model split the task "
                             "into parts by kind of work; each part is "
                             "staffed, run, and checked separately")
    parser.add_argument("--accepted", choices=["y", "n"],
                        help="record the result without prompting (for scripts)")
    parser.add_argument("--cause",
                        choices=["worker", "task_spec", "harness", "environment"],
                        help="root cause when rejecting; only 'worker' counts "
                             "against the model (default: worker)")
    parser.add_argument("--home", type=Path, default=REPO / ".owi-quick")
    arguments = parser.parse_args()

    bootstrap(arguments.home)
    stdin_text = "" if sys.stdin.isatty() else sys.stdin.read()

    if arguments.split:
        return run_split(arguments, stdin_text)

    skill = arguments.skill or classify(arguments.task)
    tokens_in = 1500 + (len(arguments.task) + len(stdin_text)) // 4
    tokens_out = 800

    privacy = PRIVACY[arguments.privacy]
    result, quote, eligible = choose(arguments.home, arguments.task, skill,
                                     tokens_in, tokens_out, arguments.rate,
                                     privacy)
    if privacy != "private_metadata":
        print(f"privacy: {privacy} — clearance gate active; the prevention "
              "memory will keep only redacted statistics")

    guessed = "" if arguments.skill else "  (guessed — --skill to change)"
    print(f"task : {arguments.task}")
    print(f"skill: {skill.replace('skill:', '')}{guessed}")
    rate_note = f" · your hour ${arguments.rate}/hr" if arguments.rate else ""
    print(f"size : ~{tokens_in} in / {tokens_out} out tokens{rate_note}")

    if not eligible:
        reasons = sorted({reason["code"]
                          for candidate in quote["rejected_candidates"]
                          for reason in candidate["reasons"]})
        print(f"\nnobody qualified: {', '.join(reasons)}")
        print("advanced: docs/BENCHMARKING.md explains how measurement fixes this")
        return 1

    if arguments.quality:
        eligible = prefer_quality(result, eligible)
    print_pick(quote, eligible, result.get("calibration"))
    model = eligible[0]["worker_id"].split(":")[1].split("/")[0]

    if not arguments.run:
        note = "" if resolve_runner(arguments.home, model) else (
            f"   (first set your command for '{model}' in "
            f"{arguments.home}/runners.json)")
        print(f"\nrun it: add --run{note}")
        return 0

    first = next_attempt_candidate(
        eligible, [], lambda m: resolve_runner(arguments.home, m) is not None)
    if first is None:
        print(f"\nno runner for any eligible worker. Fill in "
              f"{arguments.home}/runners.json")
        return 1
    explicit = bool(arguments.check) and arguments.check != ["none"]
    checklist = arguments.check if explicit else []
    if not checklist and arguments.check != ["none"]:
        tier = inspection_for(arguments.home, first["worker_id"],
                              skill)["level"]
        writer, checklist = auto_checklist(arguments.home, arguments.task,
                                           tier=tier)
        if checklist:
            print(f"checklist (auto-written by {writer}; --check none to skip):")
            for item in checklist:
                print(f"   {item}")
    verdict, _ = iterate(arguments.home, eligible, result.get("calibration"),
                         skill, arguments.task, stdin_text, checklist,
                         arguments, explicit)
    return 0 if verdict in ("accepted", "unrecorded") else 1


if __name__ == "__main__":
    raise SystemExit(main())
