{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owi:schema:office-assets:v1:sources",
  "title": "OWI office asset provenance ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_id", "policy", "records"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknown_provenance_is_allowed_in_development",
        "unknown_provenance_is_allowed_in_release",
        "notes"
      ],
      "properties": {
        "unknown_provenance_is_allowed_in_development": { "type": "boolean" },
        "unknown_provenance_is_allowed_in_release": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceRecord" }
    }
  },
  "$defs": {
    "kebabId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "description",
        "created_at",
        "created_by",
        "tool",
        "prompt",
        "input_asset_ids",
        "source_urls",
        "output_asset_ids",
        "artifacts",
        "rights"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/kebabId" },
        "kind": {
          "enum": [
            "project-authored",
            "generative-tool",
            "commissioned",
            "third-party",
            "derivative",
            "unknown"
          ]
        },
        "description": { "type": "string", "minLength": 1 },
        "created_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "created_by": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "tool": {
          "oneOf": [
            { "$ref": "#/$defs/tool" },
            { "type": "null" }
          ]
        },
        "prompt": {
          "oneOf": [
            { "$ref": "#/$defs/prompt" },
            { "type": "null" }
          ]
        },
        "input_asset_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/kebabId" }
        },
        "source_urls": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri" }
        },
        "output_asset_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/kebabId" }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "rights": { "$ref": "#/$defs/rights" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "file",
        "media_type",
        "width_px",
        "height_px",
        "has_alpha",
        "byte_size",
        "sha256"
      ],
      "properties": {
        "role": {
          "enum": [
            "generated-master",
            "processed-master",
            "editable-source",
            "intermediate",
            "runtime-output"
          ]
        },
        "file": { "$ref": "#/$defs/relativePath" },
        "media_type": {
          "enum": ["image/png", "image/webp", "image/avif", "image/svg+xml"]
        },
        "width_px": { "type": "integer", "minimum": 1 },
        "height_px": { "type": "integer", "minimum": 1 },
        "has_alpha": { "type": "boolean" },
        "byte_size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "terms_url", "terms_retrieved_at"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "terms_url": {
          "oneOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        },
        "terms_retrieved_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "file", "sha256"],
      "properties": {
        "text": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "file": {
          "oneOf": [
            { "$ref": "#/$defs/relativePath" },
            { "type": "null" }
          ]
        },
        "sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      },
      "anyOf": [
        { "required": ["text"], "properties": { "text": { "type": "string" } } },
        { "required": ["file"], "properties": { "file": { "type": "string" } } }
      ]
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "owner",
        "license_expression",
        "evidence_urls",
        "reviewed_by",
        "reviewed_at",
        "notes"
      ],
      "properties": {
        "status": { "enum": ["approved", "pending", "restricted", "unknown"] },
        "owner": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "license_expression": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "evidence_urls": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri" }
        },
        "reviewed_by": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "reviewed_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "notes": { "type": "string" }
      }
    }
  }
}
