{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owi:schema:office-assets:v2:sources",
  "title": "OWI Office graphics provenance ledger v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_id", "records"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 2 },
    "pack_id": { "const": "org.open-workforce-index.office" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "description",
        "created_at",
        "created_by",
        "tool",
        "prompt",
        "input_files",
        "output_asset_ids",
        "artifacts",
        "rights"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["generative-tool", "internal-pack-import", "project-authored"] },
        "description": { "type": "string", "minLength": 1 },
        "created_at": { "type": ["string", "null"] },
        "created_by": { "type": ["string", "null"] },
        "tool": { "type": ["object", "null"] },
        "prompt": { "type": ["object", "null"] },
        "input_files": { "type": "array", "items": { "type": "object" } },
        "output_asset_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "file", "byte_size", "sha256"],
            "properties": {
              "role": { "enum": ["generated-master", "runtime-output", "copied-runtime"] },
              "file": { "type": "string", "minLength": 1 },
              "byte_size": { "type": "integer", "minimum": 1 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "owner", "license_expression", "reviewed_by", "reviewed_at", "notes"],
          "properties": {
            "status": { "enum": ["approved", "pending", "restricted", "unknown"] },
            "owner": { "type": ["string", "null"] },
            "license_expression": { "type": ["string", "null"] },
            "reviewed_by": { "type": ["string", "null"] },
            "reviewed_at": { "type": ["string", "null"] },
            "notes": { "type": "string" }
          }
        }
      }
    }
  }
}
