{
  "manifest_version": 3,
  "name": "Open Workforce Index — Project Map",
  "short_name": "OWI Map",
  "version": "0.1.0",
  "description": "View a local project's architecture, evidence, and trusted OWI management actions.",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "Open OWI project map"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "project-map@openworkforceindex.org",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
