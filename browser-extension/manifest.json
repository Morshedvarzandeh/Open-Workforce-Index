{
  "manifest_version": 3,
  "name": "Open Workforce Index — Project Map",
  "short_name": "OWI Map",
  "version": "0.1.0",
  "description": "View a local project's architecture, evidence, and trusted OWI management actions.",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "Open OWI project map"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
